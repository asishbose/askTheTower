# Ask the Tower — the one settings file. Copy to `.env` in the repo root (gitignored, never baked into an image:
# see .gitignore and .dockerignore), fill in what you need, and every `make` target picks it up:
#
#   cp .env.example .env && make config-check
#
# How it flows:
#   - make loads every non-empty KEY=value below and exports it to every recipe: terraform, the aws CLI, boto3,
#     helm, uv/pytest and the scripts all read their settings from the environment.
#   - `make up` also copies any key that local compose uses (TOWER_BEARER … TOWER_JWT_CLIENT_IDS) into
#     deploy/compose/.env, replacing the generated value. Leave a key empty to keep the generated one.
#   - Terraform reads TF_VAR_<name> for any variable in deploy/terraform/variables.tf (or eks/variables.tf); a
#     value in envs/*.tfvars wins over TF_VAR_ if you keep both. Lists and maps use HCL: TF_VAR_x=["a","b"].
#   - Precedence: `make KEY=value` on the command line > this file > your shell's environment.
#
# Format: plain KEY=value lines. No quotes, no spaces around `=`, and no `$` or `#` in values (make would expand
# or cut them; `make` stops with the line number if it finds one). Empty value = not set.

# --- AWS credentials: ENV=aws / ENV=eks deploys, `make push`, Bedrock (ref-client, corpus), latency-aws ---------
# Prefer a profile (aws sso login / ~/.aws/config) and leave the three key lines empty. If you use keys, use a
# short-lived role session, not a long-lived user key.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Local stack secrets (deploy/compose/.env). Empty = `make up` generates a random value per machine ----------
TOWER_BEARER=
INTERNAL_BEARER=
TOWER_LINE_ID_KEY=
TOWER_MSISDN_KEY=
SESSION_SECRET=
MOCK_JWT_SECRET=
MOCK_ADMIN_TOKEN=

# --- Local stack behaviour (optional overrides of deploy/compose/.env.example) ----------------------------------
# BINDING_PUBLIC_URL=http://<laptop LAN address>:8081 lets a phone on the same Wi-Fi open the binding link.
BINDING_PUBLIC_URL=
# log | webhook. webhook also POSTs {"to","body"} to SMS_GATEWAY_URL (an SMS-gateway app on a phone; rehearsal).
ALERTS_SENDER=
SMS_GATEWAY_URL=
CARRIER_SUPPORT_NUMBER=
TOWER_TZ=

# --- Tower inbound identity (Alexa+ account linking; docs/architecture/alexa/registration.md) -------------------
TOWER_JWKS_URL=
TOWER_JWT_ISSUER=
TOWER_JWT_AUDIENCE=
TOWER_JWT_CLIENT_IDS=
# A bearer JWT for host-side tools against a deployed Tower: make demo / test-e2e / latency-aws with ENV=aws|eks.
TOWER_JWT=

# --- Reference client (Bedrock) ----------------------------------------------------------------------------------
# auto = Bedrock when AWS credentials resolve, else the scripted agent. bedrock | scripted.
REF_AGENT=
BEDROCK_MODEL_ID=

# --- Web chat page (09 §6): Cognito user passwords for `make cognito-users` (ENV=aws) ---------------------------
# Read by scripts/cognito_user.py; never written to disk. Empty = the script prompts. At least 12 characters,
# upper, lower and a digit (modules/cognito password policy).
COGNITO_PASSWORD_ASISH=
COGNITO_PASSWORD_MOM=

# --- Demo UI (laptop only; docs/architecture/components/11-demo-ui.md) ------------------------------------------
# Needed only to listen beyond 127.0.0.1 (DEMO_UI_HOST=0.0.0.0, e.g. to open it from a phone): the UI can revoke grants.
DEMO_UI_TOKEN=

# --- Terraform: ENV=aws (deploy/terraform; same names as envs/aws.tfvars.example) ------------------------------
TF_VAR_region=
TF_VAR_mock_domain_name=
TF_VAR_mock_route53_zone_id=
TF_VAR_mock_certificate_arn=
# Tower's issuer, JWKS and client come from modules/cognito; these four are overrides for a hand-made pool only.
TF_VAR_tower_jwt_discovery_url=
TF_VAR_tower_jwt_allowed_audience=
TF_VAR_tower_jwks_url=
TF_VAR_tower_jwt_issuer=
# Extra JWT clients (the Alexa account-linking client), HCL list: ["<client id>"]
TF_VAR_tower_jwt_allowed_clients=
# The web chat page (09 §6): true by default; false skips the agent runtime, S3/CloudFront and the proxy.
TF_VAR_enable_web_chat=
# The demo phones for the SNS SMS sandbox, as an HCL list: ["+1613555xxxx"]
TF_VAR_sms_sandbox_numbers=
# A real carrier sandbox instead of the mock (carrier_backend=sandbox): the secrets go to AgentCore Identity.
TF_VAR_carrier_backend=
TF_VAR_sandbox_base_url=
TF_VAR_sandbox_issuer=
TF_VAR_sandbox_token_url=
TF_VAR_sandbox_authorize_url=
TF_VAR_sandbox_client_id=
TF_VAR_sandbox_client_secret=
TF_VAR_sandbox_binding_client_id=
TF_VAR_sandbox_binding_client_secret=

# --- Terraform: ENV=eks (deploy/terraform/eks; same names as eks/envs/eks.tfvars.example) -----------------------
# Both roots read TF_VAR_region. The EKS root also needs the AWS stack's state location.
TF_VAR_aws_state_bucket=
TF_VAR_aws_state_key=
TF_VAR_tower_host=
TF_VAR_binding_host=
TF_VAR_hooks_host=
TF_VAR_certificate_arn=
