          <mxGeometry x="40" y="18" width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdr_t" value="What is real, what is mock, and what is next — as of 9 October 2026" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="100" y="14" width="1514" height="39.28" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s" value="For everyone, last: an honest status. Dashed = not executed yet. Source: docs/submission/build-log.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="100" y="53.28" width="1514" height="27.08" as="geometry" />
        </mxCell>
        <mxCell id="hdr_l" value="&lt;font color=&quot;#2BB3A0&quot;&gt;■&lt;/font&gt; real — built and run&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7583&quot;&gt;■&lt;/font&gt; mock — stands in for a carrier or a cloud service&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#0E1726&quot;&gt;■&lt;/font&gt; next — dashed, deferred" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1B2B45;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="100" y="80.36" width="1514" height="24.64" as="geometry" />
        </mxCell>
        <mxCell id="zr" value="Real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#2BB3A0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=16;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="121" width="505" height="830" as="geometry" />
        </mxCell>
        <mxCell id="zm" value="Mock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=16;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="572" y="121" width="505" height="830" as="geometry" />
        </mxCell>
        <mxCell id="zn" value="Next" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=16;fontColor=#1B2B45;dashed=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1094" y="121" width="505" height="830" as="geometry" />
        </mxCell>
        <mxCell id="b00" value="&lt;b&gt;The code&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Five services, four libraries, three tools.&lt;br&gt;Deterministic policy; consent, binding,&lt;br&gt;hash-chained audit; alerts with escalation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="166" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="b01" value="&lt;b&gt;The tests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;1,218 passing: 367 unit · 825 integration ·&lt;br&gt;26 end to end. Conformance 1,036 cases,&lt;br&gt;0 failing. Coverage 94.8 % / 90.6 %.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="355" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="b02" value="&lt;b&gt;Runs end to end&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Laptop compose and kind (Kubernetes):&lt;br&gt;the three moments + transplant story,&lt;br&gt;transcripts match golden 4/4.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="544" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="b03" value="&lt;b&gt;The AgentCore deployment path&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Terraform (main + its own ECR root),&lt;br&gt;image push, make targets, runbooks.&lt;br&gt;Written and validated offline — not yet&lt;br&gt;applied: deferred.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="733" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="&lt;b&gt;The carrier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;A CAMARA-conformant mock with a scenario&lt;br&gt;clock. Every network fact in the demo&lt;br&gt;comes from it, and the demo says “mock”.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="587" y="166" width="475" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="&lt;b&gt;Mobile data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;The mock recognises the phone by a stand-in&lt;br&gt;header; a real carrier recognises the&lt;br&gt;phone's data session. Needs a real carrier.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="587" y="330" width="475" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b12" value="&lt;b&gt;SMS, locally&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Alerts write the text to a log on the laptop.&lt;br&gt;A real text needs AWS SMS (sandbox, verified&lt;br&gt;numbers) — deferred with the AWS deploy.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="587" y="494" width="475" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b20" value="&lt;b&gt;Carrier sandbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;No sandbox credentials yet (the deck's ask).&lt;br&gt;Swapping it in is one setting; real event&lt;br&gt;timing and the real one-tap bind need it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1109" y="166" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="b21" value="&lt;b&gt;Alexa+&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Registration, account linking (Cognito pool)&lt;br&gt;and the simulator run: not done. Toolkit is&lt;br&gt;US-only; the team is in Canada.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1109" y="355" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="b22" value="&lt;b&gt;AWS, EKS, video&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;ECR → push → plan → deploy, AWS latency,&lt;br&gt;SMS sandbox, cost; the EKS window; the&lt;br&gt;demo video and screenshots. All TODO(human).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1109" y="544" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="b23" value="&lt;b&gt;Roadmap (deck slide 10)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Device-swap guard · recycled-number check ·&lt;br&gt;passwordless login. Open: spoken sentences&lt;br&gt;say “your” for Mom (fixed-person template).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=18;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1109" y="733" width="475" height="175" as="geometry" />
        </mxCell>
        <mxCell id="ftr" value="&lt;b&gt;Read next →&lt;/b&gt; 1 · back to the start&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7A90&quot;&gt;detail: docs/submission/build-log.md · README “Status and limits”&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7A90&quot;&gt;· true as of 9 October 2026&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1B2B45;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1574" height="32" as="geometry" />
        </mxCell>
