        <mxCell id="ei2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.9613;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8800;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="imgs" target="z2">
