        <mxCell id="host1" value="&lt;b&gt;Same code, different hosting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Tower: AgentCore Runtime&lt;br&gt;Carrier calls: Gateway + Identity&lt;br&gt;Mock carrier: Fargate&lt;br&gt;Binding page: Lambda + API Gateway&lt;br&gt;Alerts: Lambda + Scheduler + SNS&lt;br&gt;Store: DynamoDB + KMS&lt;br&gt;&lt;b&gt;Deferred&lt;/b&gt; — terraform validate passes; never planned or applied&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=17;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="286" width="460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="cmd1" value="&lt;b&gt;Make commands&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;make ecr-up  (once)&lt;br&gt;make push ENV=aws&lt;br&gt;make plan → make deploy&lt;br&gt;make demo ENV=aws&lt;br&gt;make down ENV=aws  (keeps ECR)&lt;br&gt;make down-all  (after judging)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=17;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="571" width="460" height="205" as="geometry" />
        </mxCell>
        <mxCell id="ec1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=11;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="host1" target="cmd1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="host2" value="&lt;b&gt;Same code, different hosting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Tower: Deployment + Ingress&lt;br&gt;Carrier calls: direct client → mock pod&lt;br&gt;Mock carrier: Deployment&lt;br&gt;Binding page: Deployment + Ingress&lt;br&gt;Alerts: Deployment + CronJobs + SNS&lt;br&gt;Store: DynamoDB + KMS (EKS)&lt;br&gt;&lt;b&gt;kind ✓ 4/4&lt;/b&gt; · EKS: not run, deferred&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=17;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="286" width="460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="cmd2" value="&lt;b&gt;Make commands&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;make helm-kind  (kind ✓)&lt;br&gt;make deploy-eks&lt;br&gt;make demo ENV=eks&lt;br&gt;make down-eks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=17;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="571" width="460" height="205" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=11;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="host2" target="cmd2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value="&lt;b&gt;ECR registry — shared prerequisite for AWS and EKS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Its own Terraform root: make ecr-up once. Survives make down ENV=aws — the images are kept;&lt;br&gt;only make down-all deletes it. Not created yet — deferred.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=17;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="575" y="851" width="1025" height="110" as="geometry" />
        </mxCell>
        <mxCell id="er1" value="images" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8A33D;strokeWidth=2;fontSize=12;fontColor=#3C4858;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.2439;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecr" target="z1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="34" y="0" as="offset" />
