        <mxCell id="host0" value="&lt;b&gt;Same code, different hosting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Tower: container&lt;br&gt;Carrier calls: direct client → mock&lt;br&gt;Mock carrier: container&lt;br&gt;Binding page: container&lt;br&gt;Alerts: container; SMS → log&lt;br&gt;Store: DynamoDB Local&lt;br&gt;&lt;b&gt;Ran ✓&lt;/b&gt; — transcripts match golden 4/4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=17;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="286" width="460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="cmd0" value="&lt;b&gt;Make commands&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;make up&lt;br&gt;make seed&lt;br&gt;make demo&lt;br&gt;make down&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=17;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="571" width="460" height="205" as="geometry" />
        </mxCell>
        <mxCell id="ec0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=11;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="host0" target="cmd0">
          <mxGeometry relative="1" as="geometry" />
