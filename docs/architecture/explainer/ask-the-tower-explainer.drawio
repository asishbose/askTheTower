        <mxCell id="ftr" value="&lt;b&gt;Read next →&lt;/b&gt; 9 · How we know it works&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7A90&quot;&gt;detail: 08-agentcore-deployment.drawio · deployment-agentcore.md&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7A90&quot;&gt;· true as of 9 October 2026&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1B2B45;fontStyle=0;spacing=4;" vertex="1" parent="1">
