        </mxCell>
        <mxCell id="er2" value="images" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8A33D;strokeWidth=2;fontSize=12;fontColor=#3C4858;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.7561;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecr" target="z2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="34" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;&lt;font color=&quot;#2BB3A0&quot;&gt;①&lt;/font&gt;&lt;/b&gt; The claim: &lt;b&gt;make demo ENV=local|eks|aws&lt;/b&gt; prints the same transcripts. Local and kind already do; AWS and EKS are the deferred half of the proof." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1B2B45;fontStyle=0;spacing=4;" vertex="1" parent="1">
