        <mxCell id="e_ma" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8A33D;strokeWidth=2;fontSize=11;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.8108;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8108;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="mock" target="alerts">
