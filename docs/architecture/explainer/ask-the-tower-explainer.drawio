        <mxCell id="e_gm" value="CAMARA, OAuth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2BB3A0;strokeWidth=2;fontSize=11;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.2500;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1802;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="mock">
