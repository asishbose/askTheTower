        <mxCell id="hdr_n" value="9/10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#6B7A90;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdr_t" value="1,218 tests pass on a laptop and the mock matches the CAMARA specs; cloud numbers come next" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="100" y="14" width="1514" height="39.28" as="geometry" />
        </mxCell>
        <mxCell id="hdr_s" value="For judges and engineers: the evidence, with the real counts from artifacts/test-report.md (run 2026-10-07)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="100" y="53.28" width="1514" height="27.08" as="geometry" />
        </mxCell>
        <mxCell id="hdr_l" value="&lt;font color=&quot;#2BB3A0&quot;&gt;■&lt;/font&gt; passed&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7583&quot;&gt;■&lt;/font&gt; deferred / not measured (dashed)&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#E8A33D&quot;&gt;■&lt;/font&gt; gates that fail the build" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1B2B45;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="100" y="80.36" width="1514" height="24.64" as="geometry" />
        </mxCell>
        <mxCell id="e2e" value="&lt;b&gt;End to end — 26 passed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;0 failed · 3 skipped (EKS only)&lt;br&gt;the three moments + chaos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=16;fontColor=#1B2B45;align=center;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="131" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="int" value="&lt;b&gt;Integration — 825 passed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;0 failed · 1 skipped (AWS latency)&lt;br&gt;contract, conformance, privacy, latency; DynamoDB Local&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=16;fontColor=#1B2B45;align=center;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="256" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="unit" value="&lt;b&gt;Unit — 367 passed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;0 failed · 0 skipped&lt;br&gt;coverage, unit + integration: libraries 94.8 % · services 90.6 %&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=16;fontColor=#1B2B45;align=center;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="391" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="conf" value="&lt;b&gt;Conformance: mock vs CAMARA specs ✓&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;15 operations, 1,036 generated cases (schemathesis), 0 failing.&lt;br&gt;The mock is spec-conformant; it does not claim real-carrier timing.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=16;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="131" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="priv" value="&lt;b&gt;Privacy greps ✓  (19 tests, zero hits)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;No phone-number-shaped string and no health word in any log, transcript,&lt;br&gt;answer or SMS; never an alert to the swapped line. make privacy-grep re-runs it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=16;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="256" width="740" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lat" value="&lt;b&gt;Latency gate: 95th percentile &amp;lt; 400 ms&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Laptop compose: is my line OK? 236.7 ms · is Mom reachable? 311.7 ms ✓&lt;br&gt;AWS: — (measured in prompt 13, make latency-aws; deferred)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=16;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="391" width="740" height="120" as="geometry" />
        </mxCell>
        <mxCell id="same" value="&lt;b&gt;Same transcripts everywhere&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Local compose 4/4 ✓ · kind 4/4 ✓ · EKS — deferred · AWS — deferred · Alexa+ tool-choice corpus on Bedrock — not measured yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=16;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="551" width="1550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="show" value="&lt;b&gt;The showcase, in nine steps (the video and the live run)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;① Mock carrier and its clock  →  ② Policy table: every decision  →  ③ Binding: the one tap  →  ④ Moment 1: the dead phone&lt;br&gt;→  ⑤ Moment 2: forwarding  →  ⑥ Moment 3: Mom's line, the text, revoke  →  ⑦ Transplant story: 20 minutes dark&lt;br&gt;→  ⑧ Audit: Mom's view, chain verified  →  ⑨ make demo: the same transcripts from a terminal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=16;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="661" width="1550" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cl" value="&lt;b&gt;&lt;font color=&quot;#E8A33D&quot;&gt;Gates.&lt;/font&gt;&lt;/b&gt; Every gate fails the build: 100 % pass per layer, coverage ≥ 90 % / ≥ 80 %, 0 failing conformance operations, zero privacy hits, p95 under 400 ms. &lt;br&gt;&lt;b&gt;Not claimed.&lt;/b&gt; What the tests deliberately do not claim: real-carrier timing, that Alexa+ always picks the right tool, that “reachable” means the phone will ring." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1B2B45;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="831" width="1550" height="41.72" as="geometry" />
        </mxCell>
        <mxCell id="ftr" value="&lt;b&gt;Read next →&lt;/b&gt; 10 · What is real, what is mock, what is next&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7A90&quot;&gt;detail: 06-test-topology.drawio · artifacts/test-report.md&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#6B7A90&quot;&gt;· true as of 9 October 2026&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1B2B45;fontStyle=0;spacing=4;" vertex="1" parent="1">
