<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device"><diagram id="04_binding_flow" name="04 Binding Flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_main" value="Path C — one tap on the phone, over mobile data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#1B2B45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="Number Verification needs the device on the carrier&#x27;s network. An Echo on Wi-Fi cannot do this; the phone can, once." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7A90;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1540" height="22" as="geometry"/></mxCell><mxCell id="b_alexa" value="Alexa+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p1" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="141" as="sourcePoint"/><mxPoint x="140.0" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b_tower" value="Tower MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p2" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="141" as="sourcePoint"/><mxPoint x="380.0" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b_phone" value="User&#x27;s phone&lt;br&gt;(Wi-Fi OFF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p3" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="141" as="sourcePoint"/><mxPoint x="620.0" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b_page" value="Binding page&lt;br&gt;(Lambda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p4" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="141" as="sourcePoint"/><mxPoint x="860.0" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b_gw" value="Carrier gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p5" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100.0" y="141" as="sourcePoint"/><mxPoint x="1100.0" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b_car" value="Carrier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p6" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340.0" y="141" as="sourcePoint"/><mxPoint x="1340.0" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7" value="line_is_ok(&quot;self&quot;)" style="edgeStyle=none;html=1;strokeColor=#2BB3A0;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="175" as="sourcePoint"/><mxPoint x="380.0" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p8" value="NOT_BOUND · next_step: bind_line (URL, 10-min token)" style="edgeStyle=none;html=1;strokeColor=#C57B7B;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="210" as="sourcePoint"/><mxPoint x="140.0" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n225b_alexa" value="&quot;I need to connect your line first — I&#x27;ve texted you a link.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="154.0" y="225" width="300" height="30" as="geometry"/></mxCell><mxCell id="p9" value="SMS with link (via Alerts/SNS)" style="edgeStyle=none;html=1;strokeColor=#E8A33D;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="290" as="sourcePoint"/><mxPoint x="620.0" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p10" value="GET /bind/{token}" style="edgeStyle=none;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="330" as="sourcePoint"/><mxPoint x="860.0" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11" value="page: &quot;turn Wi-Fi off, tap Verify&quot;" style="edgeStyle=none;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="365" as="sourcePoint"/><mxPoint x="620.0" y="365" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p12" value="POST /bind/{token}/verify" style="edgeStyle=none;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="400" as="sourcePoint"/><mxPoint x="860.0" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p13" value="auth-code start (network authentication — no password)" style="edgeStyle=none;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="435" as="sourcePoint"/><mxPoint x="1340.0" y="435" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p14" value="redirect: carrier recognises the data session" style="edgeStyle=none;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340.0" y="470" as="sourcePoint"/><mxPoint x="620.0" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p15" value="redirect back with code" style="edgeStyle=none;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="505" as="sourcePoint"/><mxPoint x="860.0" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p16" value="number-verification/verify(code)" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="540" as="sourcePoint"/><mxPoint x="1100.0" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p17" value="POST /number-verification/verify" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100.0" y="575" as="sourcePoint"/><mxPoint x="1340.0" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p18" value="{devicePhoneNumberVerified:true, number}" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340.0" y="610" as="sourcePoint"/><mxPoint x="860.0" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n625b_page" value="store Lines{line_id = HMAC(number), owner, bound_at}&lt;br&gt;number never typed by the user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="874.0" y="625" width="300" height="44" as="geometry"/></mxCell><mxCell id="p19" value="&quot;Line connected.&quot;  + optional: grant watch to &lt;invite code&gt; as &quot;mom&quot;" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="700" as="sourcePoint"/><mxPoint x="620.0" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p20" value="if a Watch was created → Alerts subscribes (SIM swap · reachability)" style="edgeStyle=none;html=1;strokeColor=#E8A33D;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="740" as="sourcePoint"/><mxPoint x="380.0" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="bf_n" value="Mock simulation: the carrier&#x27;s network attribution is replaced by an X-Mock-Client-Id header the test phone sends. Documented as a simulation on the slide; the page is unchanged against a real carrier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#6B7A90;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1520" height="44" as="geometry"/></mxCell><!-- gen_extend:begin --><mxCell id="x_zone" value="Invite, grant, watch settings, watch and revoke, as built (04 §3, §9) — added by gen_extend.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=13;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="28" y="920" width="1544" height="430" as="geometry" /></mxCell><mxCell id="x_inv" value="&lt;b&gt;Asish (grantee) on his own page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/me → “Create invite code” → POST /me/invite (grants.py:87): 8 letters shown ABCD-EFGH, 24 h, single use (invite.py:40)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_pass" value="&lt;b&gt;The code reaches Mom out of band&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;said aloud or texted by Asish; letters only, so it can never look like a phone number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="432" y="960" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_grant" value="&lt;b&gt;Mom grants on her page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;session from her own bind; POST /grants {invite_code, watch | reachability, alias &quot;mom&quot;} → grant() (grants.py:111; tower_consent grants.py:38); invite consumed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="960" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_watch" value="&lt;b&gt;Asish: “Alexa, watch mom's line”&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;watch_line(&quot;mom&quot;, enable=true) → his own Watch (care) + Alerts /internal/watch → subscribe. The page creates no Watch (D7, grant half open)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="1216" y="960" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_inv" target="x_pass"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_pass" target="x_grant"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_grant" target="x_watch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_set" value="&lt;b&gt;Mom: Watching card on /me (6b)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;profile by behaviour (fraud only / must stay reachable / daytime check-in) + up to 3 contacts in order, from her line's active watch grantees&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_save" value="&lt;b&gt;POST /me/lines/{line_id}/watch-settings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;set_watch_settings (watch_settings.py:26): owner only (403); contacts need an active watch grant (422); one UpdateItem on her own Watch, requires_ack derived; enabled untouched&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="432" y="1060" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_saud" value="&lt;b&gt;Audit, then Alerts if alerts are on&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;one row watch_line · binding · ok, no contact ids; enabled Watch → POST /internal/watch {profile} (watching.py; a failure is swallowed, the polls cover it)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="1060" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_mine" value="&lt;b&gt;Mom: “Alexa, watch my line”&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;watch_line(self, true) keeps the stored profile and chain (watch_line.py:121); facts.profile reports it, contacts never (06 §11.1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="1216" y="1060" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_set" target="x_save"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_save" target="x_saud"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_saud" target="x_mine"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_rev" value="&lt;b&gt;Mom revokes — on the page only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;POST /grants/{id}/revoke (grants.py:144) → revoked_at (tower_consent grants.py); never by voice (04 §3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_after" value="&lt;b&gt;Next read sees it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Asish's line_is_ok(&quot;mom&quot;) → NO_CONSENT (resolve.py:89); Alerts drops any alert as SUPPRESSED_REVOKED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="432" y="1160" width="342" height="82" as="geometry" /></mxCell><mxCell id="x_left" value="&lt;b&gt;Also on revoke (D7, D8)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the grantee's Watch is disabled (watches.py disable_watch) and they leave Mom's contact chain (watches.py:83 remove_contact);&lt;br&gt;the Alerts watchdog drops subscriptions no enabled, consented Watch needs on its next poll. The page never calls Alerts on revoke.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="1160" width="734" height="82" as="geometry" /></mxCell><mxCell id="x_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_rev" target="x_after"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_after" target="x_left"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_note" value="&lt;font style=&quot;font-size:10px&quot;&gt;Also as built: no code sends the link SMS (step “SMS with link”, D1); Alexa+ gets the URL in next_step only.&lt;br&gt;The bind calls Number Verification phoneNumberShare — the carrier returns devicePhoneNumber (core.py:240) — not verify(number) as drawn above (D12).&lt;br&gt;The step label “grant watch to &amp;lt;invite code&amp;gt; as mom” renders without its placeholder: the tag is read as HTML (D13).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=10;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="60" y="1260" width="1480" height="70" as="geometry" /></mxCell><!-- gen_extend:end --></root></mxGraphModel></diagram></mxfile>