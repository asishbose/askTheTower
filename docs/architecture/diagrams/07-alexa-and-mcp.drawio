<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device"><diagram id="07_alexa_and_mcp" name="07 Alexa and MCP"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Ask the Tower — where Alexa+ is, where the MCP server is, and what flows between them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#1B2B45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1700" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Teal = request path · purple = account linking (once) · grey = line binding (once) · amber = proactive alert. Alexa+ lives in Amazon&#x27;s cloud; Tower (the MCP server) lives in our AWS account on AgentCore Runtime." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1700" height="22" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;At home&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;fontSize=14;fontColor=#1B2B45;align=left;verticalAlign=top;dashed=0;fontStyle=0;spacing=8;arcSize=40;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="290" height="820" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Amazon — Alexa cloud (not ours)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=14;fontColor=#1B2B45;align=left;verticalAlign=top;dashed=0;fontStyle=0;spacing=8;arcSize=40;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="350" height="820" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Our AWS account&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#2BB3A0;fontSize=14;fontColor=#1B2B45;align=left;verticalAlign=top;dashed=0;fontStyle=0;spacing=8;arcSize=40;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="730" y="100" width="700" height="820" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Carrier (CAMARA APIs)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E0;strokeColor=#E8A33D;fontSize=14;fontColor=#1B2B45;align=left;verticalAlign=top;dashed=0;fontStyle=0;spacing=8;arcSize=40;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="1460" y="100" width="310" height="820" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Echo / Alexa app&lt;/b&gt;&lt;br&gt;voice in, speech out&lt;br&gt;(still on home Wi-Fi when the phone dies)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="180" width="240" height="70" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;User&#x27;s phone&lt;/b&gt;&lt;br&gt;mobile data · one tap to bind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="600" width="240" height="70" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Watcher&#x27;s phone&lt;/b&gt;&lt;br&gt;the consented second person&lt;br&gt;receives SMS alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="760" width="240" height="70" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Alexa+ assistant (LLM)&lt;/b&gt;&lt;br&gt;speech → picks a tool from its description&lt;br&gt;phrases Tower&#x27;s result back as speech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="375" y="175" width="300" height="80" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Alexa+ MCP Toolkit&lt;/b&gt;&lt;br&gt;the MCP client · Streamable HTTP&lt;br&gt;sends the account-link token on every call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="375" y="330" width="300" height="80" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Account linking&lt;/b&gt;&lt;br&gt;OAuth 2.0 auth-code client&lt;br&gt;stores the token per Amazon account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="375" y="480" width="300" height="70" as="geometry"/></mxCell><mxCell id="v13" value="Alexa+ cannot speak first: an MCP add-on is request/response only. Every proactive message is an SMS from Alerts (amber). No phone number ever crosses this edge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#3C4858;align=left;verticalAlign=middle;dashed=1;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="375" y="760" width="300" height="100" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Tower MCP server&lt;/b&gt;&lt;br&gt;AgentCore Runtime · POST /mcp&lt;br&gt;JWT authorizer (Cognito)&lt;br&gt;&lt;b&gt;line_is_ok · is_reachable · watch_line&lt;/b&gt;&lt;br&gt;&lt;i&gt;policy · consent · audit run in-process&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="755" y="290" width="310" height="140" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;user pool · hosted sign-in UI · JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C8;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="755" y="480" width="310" height="70" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;DynamoDB + KMS&lt;/b&gt;&lt;br&gt;Users · Lines · Grants · Watches · Audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110" y="175" width="290" height="75" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;AgentCore Gateway + Identity&lt;/b&gt;&lt;br&gt;CAMARA OpenAPI → MCP tools&lt;br&gt;injects the carrier OAuth token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110" y="300" width="290" height="90" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Binding page&lt;/b&gt;&lt;br&gt;Lambda + API Gateway&lt;br&gt;Number Verification flow · grants · revoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="755" y="620" width="310" height="80" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Alerts&lt;/b&gt;&lt;br&gt;Lambda · webhook + poll&lt;br&gt;→ same policy → consent re-check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110" y="620" width="290" height="80" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;EventBridge&lt;br&gt;Scheduler&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110" y="750" width="135" height="60" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;SNS&lt;/b&gt;&lt;br&gt;SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1265" y="750" width="135" height="60" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;Carrier APIs&lt;/b&gt;&lt;br&gt;mock on Fargate (demo default)&lt;br&gt;or a carrier sandbox — same OpenAPI&lt;br&gt;&lt;br&gt;SIM Swap · Call Forwarding&lt;br&gt;Device Reachability · Number Verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1485" y="280" width="260" height="130" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Event subscriptions&lt;/b&gt;&lt;br&gt;CloudEvents webhooks&lt;br&gt;(SIM swap · reachability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1485" y="620" width="260" height="80" as="geometry"/></mxCell><mxCell id="e24" value="① ask / ⑧ answer" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2BB3A0;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="215" as="sourcePoint"/><mxPoint x="375" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="② tools/call&lt;br&gt;line_is_ok {line:&amp;quot;self&amp;quot;}" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2BB3A0;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="255" as="sourcePoint"/><mxPoint x="525" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="③ MCP · Streamable HTTP&lt;br&gt;Bearer JWT" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2BB3A0;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="355" as="sourcePoint"/><mxPoint x="755" y="355" as="targetPoint"/><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="e27" value="⑦ {summary, facts,&lt;br&gt;reason_codes}" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2BB3A0;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="400" as="sourcePoint"/><mxPoint x="675" y="400" as="targetPoint"/><mxPoint x="0" y="32" as="offset"/></mxGeometry></mxCell><mxCell id="e28" value="④ consent read · audit append" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2BB3A0;strokeWidth=1;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="290" as="sourcePoint"/><mxPoint x="1110" y="212" as="targetPoint"/><Array as="points"><mxPoint x="910" y="212"/></Array></mxGeometry></mxCell><mxCell id="e29" value="⑤" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2BB3A0;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="345" as="sourcePoint"/><mxPoint x="1110" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e30" value="⑥ HTTPS&lt;br&gt;+ OAuth" style="edgeStyle=none;html=1;rounded=1;strokeColor=#2BB3A0;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="345" as="sourcePoint"/><mxPoint x="1485" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e31" value="L1 link account (once)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#7B61C8;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="250" as="sourcePoint"/><mxPoint x="375" y="515" as="targetPoint"/><Array as="points"><mxPoint x="175" y="515"/></Array><mxPoint x="40" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e32" value="L2 sign in&lt;br&gt;→ token" style="edgeStyle=none;html=1;rounded=1;strokeColor=#7B61C8;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="515" as="sourcePoint"/><mxPoint x="755" y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="token" style="edgeStyle=none;html=1;rounded=1;strokeColor=#7B61C8;strokeWidth=1;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="480" as="sourcePoint"/><mxPoint x="600" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e34" value="L3 verify JWT (JWKS)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#7B61C8;strokeWidth=1;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="480" as="sourcePoint"/><mxPoint x="910" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e35" value="B1 HTTPS over mobile data (Wi-Fi off)" style="edgeStyle=none;html=1;rounded=1;strokeColor=#6B7583;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="650" as="sourcePoint"/><mxPoint x="755" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e36" value="B2 number-&lt;br&gt;verification" style="edgeStyle=none;html=1;rounded=1;strokeColor=#6B7583;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="640" as="sourcePoint"/><mxPoint x="1180" y="390" as="targetPoint"/><Array as="points"><mxPoint x="1085" y="640"/><mxPoint x="1085" y="420"/><mxPoint x="1180" y="420"/></Array></mxGeometry></mxCell><mxCell id="e37" value="subscribe" style="edgeStyle=none;html=1;rounded=1;strokeColor=#E8A33D;strokeWidth=1;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1615" y="410" as="sourcePoint"/><mxPoint x="1615" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e38" value="P1 event" style="edgeStyle=none;html=1;rounded=1;strokeColor=#E8A33D;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1485" y="660" as="sourcePoint"/><mxPoint x="1400" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e39" value="P2 poll" style="edgeStyle=none;html=1;rounded=1;strokeColor=#E8A33D;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1177" y="750" as="sourcePoint"/><mxPoint x="1177" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e40" value="P3 fetch&lt;br&gt;facts" style="edgeStyle=none;html=1;rounded=1;strokeColor=#E8A33D;strokeWidth=1;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="620" as="sourcePoint"/><mxPoint x="1350" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#E8A33D;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1332" y="700" as="sourcePoint"/><mxPoint x="1332" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e42" value="P4 templated SMS to the watcher — never to the swapped number" style="edgeStyle=none;html=1;rounded=1;strokeColor=#E8A33D;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#1B2B45;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1332" y="810" as="sourcePoint"/><mxPoint x="175" y="830" as="targetPoint"/><Array as="points"><mxPoint x="1332" y="890"/><mxPoint x="175" y="890"/></Array></mxGeometry></mxCell><mxCell id="t43" value="&lt;b&gt;Request — &amp;quot;Alexa, is my line OK?&amp;quot;&lt;/b&gt;&lt;br&gt;① User speaks to the Echo.&lt;br&gt;② Alexa+ chooses &lt;code&gt;line_is_ok&lt;/code&gt; from the tool descriptions.&lt;br&gt;③ Toolkit calls Tower&#x27;s &lt;code&gt;/mcp&lt;/code&gt; with the linked user&#x27;s JWT.&lt;br&gt;④ Tower: one consent read; refuses if not bound or not granted.&lt;br&gt;⑤⑥ Gateway calls SIM Swap + Call Forwarding at the carrier.&lt;br&gt;⑦ Policy decides, audit row is written, then the structured result returns.&lt;br&gt;⑧ Alexa+ speaks the &lt;code&gt;summary&lt;/code&gt;. No model between ③ and ⑦." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#3C4858;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="950" width="420" height="230" as="geometry"/></mxCell><mxCell id="t44" value="&lt;b&gt;Account linking — who is speaking (once)&lt;/b&gt;&lt;br&gt;L1 In the Alexa app the user enables Tower and links the account.&lt;br&gt;L2 Cognito sign-in; Alexa stores the access token.&lt;br&gt;L3 Tower checks the JWT (issuer, client_id, exp) and uses &lt;code&gt;sub&lt;/code&gt; as user_id.&lt;br&gt;&lt;br&gt;&lt;b&gt;Binding — which phone is theirs (once)&lt;/b&gt;&lt;br&gt;B1 Link opened on the phone with Wi-Fi off.&lt;br&gt;B2 Number Verification via the Gateway; the line and grants go to DynamoDB." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#3C4858;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="950" width="420" height="230" as="geometry"/></mxCell><mxCell id="t45" value="&lt;b&gt;Proactive — Alexa+ is not on this path&lt;/b&gt;&lt;br&gt;P1 Carrier pushes a SIM-swap CloudEvent to Alerts, or&lt;br&gt;P2 EventBridge triggers a scheduled poll.&lt;br&gt;P3 Alerts fetches the current facts and runs the same policy as Tower.&lt;br&gt;P4 Consent re-checked, audit row written, then SNS texts the watcher." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#3C4858;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="910" y="950" width="420" height="230" as="geometry"/></mxCell><mxCell id="v46" value="&lt;b&gt;Demo from Canada (local)&lt;/b&gt;&lt;br&gt;Alexa+ web simulator → &lt;code&gt;cloudflared&lt;/code&gt; tunnel → Tower in Docker Compose on &lt;code&gt;localhost:8080/mcp&lt;/code&gt; → DirectClient → mock carrier container. The &lt;code&gt;/mcp&lt;/code&gt; endpoint and the JWT check are the same; only the hosting changes. If toolkit access is not available, the Strands reference client makes the same MCP calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=top;dashed=1;fontStyle=0;spacing=8;" vertex="1" parent="1"><mxGeometry x="1350" y="950" width="420" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
