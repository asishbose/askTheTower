        <mxCell id="phone" value="Phone on the same Wi-Fi (scans the QR code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8A33D;strokeColor=#E8A33D;fontSize=11;fontColor=#0E1726;align=center;verticalAlign=middle;dashed=0;fontStyle=1;spacing=4;" vertex="1" parent="1">
