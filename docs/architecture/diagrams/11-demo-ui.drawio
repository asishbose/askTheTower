<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device">
  <diagram id="11_local" name="1 ENV=local">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_main" value="11 · Demo UI (control room): four panes, ENV=local" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_sub" value="Demo tooling, laptop only (built 2026-10-09). It drives only what make demo and the showcase scripts already drive; it owns nothing." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t_sub2" value="Teal = the conversation (request path) · amber = the live feed (proactive evidence) · grey = demo controls and binding · Gn = the gap closed for it (doc 11 §10)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="66" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="z_laptop" value="Presenter's laptop (ENV=local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="1410" height="1010" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser: desktop or phone (mobile layout)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;one static page, HTMX + SSE, no build step · 127.0.0.1:8090 · any other address needs DEMO_UI_TOKEN&lt;br&gt;top-bar pill: agent mode (scripted in compose, bedrock on the host) and ENV&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="560" height="84" as="geometry" />
        </mxCell>
        <mxCell id="z_ui" value="services/demo-ui (FastAPI + HTMX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="560" height="840" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1 · Conversation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;type as Asish or Mom · macros: Moment 1 · Moment 2 · Moment 3 · Transplant&lt;br&gt;ref_client as a library: TowerClient, BedrockAgent, or ScriptedAgent without Bedrock&lt;br&gt;shows tool call · reason_codes chips (Tower's only) · summary / spoken · next_step&lt;br&gt;macros: run_demo(STORIES, reset=False, on_step) (G4): per step id, narration,&lt;br&gt;expected vs actual codes, pass/fail, timing · one timeline, one run at a time&lt;br&gt;next_step bind_line → url → QR code in pane 4 (D1: nothing texts the link)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2 · Carrier controls (mock /_admin)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Reset = the make seed code · clock +1 / +12 / +20 min · fire sim_swap cf_set cf_clear&lt;br&gt;unreachable reachable by holder (Asish, Mom) and the mock's opaque ref, never by number:&lt;br&gt;GET /_admin/state?view=refs, POST /_admin/lines/{ref}/events (G2): no number on the wire&lt;br&gt;faults timeout / 500 / 429 · Bearer MOCK_ADMIN_TOKEN on every mutation (G1)&lt;br&gt;ENV=aws: off with the reason (decision 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="490" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3 · Live feed (SSE, one poller, every 2 s)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;audit: list_lines(owner) → list_for_line(line, owner): Asish's log + Mom's log, newest 50&lt;br&gt;sms: GET /internal/sent?after=n (G3): template id, role, user id, body; never a number&lt;br&gt;also per tick: mock /_admin/state?view=refs (pane 2) and binding /_admin/tables (pane 4)&lt;br&gt;no DynamoDB Streams · the chain check stays on the binding page /me (the UI holds no keys)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="680" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4 · Binding (QR code · grants · revoke)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;QR code of POST /_admin/bind-tokens {user_id} → url + ?as=phone-&amp;lt;who&amp;gt;, drawn by the UI&lt;br&gt;grants: GET /_admin/tables?format=json · resolve: GET /_admin/resolve?user=..&amp;amp;line=..&lt;br&gt;revoke / re-grant: POST /_admin/grants {owner, grantee, grant, alias, action}&lt;br&gt;the QR code is drawn by the UI (segno, SVG); the phone opens the page, never the UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="870" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="redact" value="&lt;font style=&quot;font-size:9px&quot;&gt;every HTML fragment and SSE frame → number filter (demo_ui.redact) · uvicorn access_log off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1035" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z_compose" value="compose stack (built)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="250" width="530" height="840" as="geometry" />
        </mxCell>
        <mxCell id="tower" value="&lt;b&gt;tower-mcp :8080 /mcp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;MCP tools/list · tools/call · Bearer TOWER_BEARER + X-Tower-User&lt;br&gt;each turn is an ordinary check: consent read, carrier calls, audit row&lt;br&gt;the UI adds nothing to this path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="350" width="470" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mock" value="&lt;b&gt;mock-carrier 127.0.0.1:8443 /_admin/* (MOCK_ADMIN=1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GET /state?view=refs · GET /scenarios · GET /clock: open (Tower, Alerts)&lt;br&gt;POST /scenarios/load · POST /clock {advance_s}&lt;br&gt;POST /lines/{ref}/events {event} · POST /faults · DELETE /faults&lt;br&gt;every POST / DELETE: Bearer MOCK_ADMIN_TOKEN (G1) · GET /healthz&lt;br&gt;(routers/admin.py)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="490" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alerts" value="&lt;b&gt;alerts :8082&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GET /internal/sent?after=n: ALERTS_MODE=local only, internal bearer (G3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="680" width="470" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="&lt;b&gt;DynamoDB Local :8000 (read only)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Lines by_owner (bind.py:124) · Audit via reader.py:63, owner check :57&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="770" width="470" height="70" as="geometry" />
        </mxCell>
        <mxCell id="binding" value="&lt;b&gt;binding-page :8081 /_admin/*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;POST /bind-tokens {user_id} · GET /tables?format=json&lt;br&gt;GET /resolve?user=..&amp;amp;line=.. · POST /grants {...}&lt;br&gt;404 unless TOWER_ENV=local and BIND_ADMIN=1 (config.py)&lt;br&gt;(routes/admin.py) · GET /bind/{token} for the phone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="870" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="z_aws" value="AWS: Bedrock only (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E0;strokeColor=#E8A33D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1470" y="250" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="&lt;b&gt;Bedrock Converse (tool use)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;BEDROCK_MODEL_ID (amazon.nova-micro-v1:0) · AWS_PROFILE&lt;br&gt;the repo's only model call stays in ref_client/agent.py&lt;br&gt;absent → ScriptedAgent; free text turned off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
