  <diagram id="11_aws" name="2 ENV=aws (laptop)">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_main" value="11 · Demo UI, ENV=aws: on the laptop, pointed at the account, never deployed into it" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_sub" value="The same container (or uv run) reading deploy/.env.aws. Nothing of the UI is created in AWS. Dashed = the demo admin path: only while demo_admin_cidrs is non-empty (prompt 22, U2), CIDR and bearer on every call." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t_sub2" value="Solid = reachable from the laptop by default · dashed = only with the admin path open · no edge = no laptop path. Asish only (decision 3). Pane 5 runs nothing with ENV=aws (U3)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="66" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="z_laptop" value="Presenter's laptop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="700" height="900" as="geometry" />
        </mxCell>
        <mxCell id="z_ui" value="services/demo-ui (same image, or uv run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="640" height="820" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1 · Conversation: works&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;TOWER_URL = the Runtime URL from deploy/.env.aws&lt;br&gt;TOWER_BEARER must be a JWT; D21: an empty discovery URL means every call gets 401&lt;br&gt;X-Tower-User is ignored on AWS: Asish only, no persona switch (decision 3)&lt;br&gt;Bedrock with the att profile, or ScriptedAgent; pill: mode · ENV=aws · admin on|off&lt;br&gt;admin open: Moment 1–3 on; Transplant stays local (D-I, no partner/neighbour on AWS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="190" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2 · Carrier controls, Reset: admin path only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;closed (default): off, &quot;admin path closed: see pane 5 step 6&quot;&lt;br&gt;open: MOCK_URL = https://&amp;lt;api&amp;gt;/carrier-admin + Bearer DEMO_ADMIN_BEARER&lt;br&gt;state (view=refs forced by the gateway), clock, events by ref, faults&lt;br&gt;Reset (U3, aws_reset.py): mock scenarios/load → Alerts /internal/reset&lt;br&gt;→ binding /_admin/grants re-grant (Cognito subs); never the local seed module&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3 · Live feed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;audit: DynamoDB with the att profile; TOWER_TABLE_PREFIX from .env.aws&lt;br&gt;polled every 5 s: about 3 reads/s while the page is open, cents per day&lt;br&gt;SMS, admin open: GET /internal/sent from the SentSms table (U1), same wire shape&lt;br&gt;SMS, closed: &quot;SMS list unavailable&quot;; the text lands on the real phone&lt;br&gt;and the audit row with message_ref is the evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="610" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4 · Binding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;always: the QR code of Tower's NOT_BOUND next_step.url&lt;br&gt;admin open: grants (table=Grants), resolve, revoke and re-grant through&lt;br&gt;/_admin in bearer mode (DEMO_ADMIN_BEARER); /me on the phone is unchanged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="820" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z_aws" value="AWS account (the demo UI is not in it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="930" height="900" as="geometry" />
