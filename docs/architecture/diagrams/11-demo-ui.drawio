  <diagram id="11_aws" name="2 ENV=aws (laptop)">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_main" value="11 · Demo UI, ENV=aws: on the laptop, pointed at the account, never deployed into it" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_sub" value="The same container (or uv run) with deploy/.env.aws loaded. Nothing is created in AWS. Each pane works only as far as a laptop can reach." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t_sub2" value="Solid edge = reachable from the laptop · no edge = no laptop path: pane 2, Reset and the macros are local-only (decision 2); Asish only (decision 3)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="66" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="z_laptop" value="Presenter's laptop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="700" height="900" as="geometry" />
        </mxCell>
        <mxCell id="z_ui" value="services/demo-ui (same image, or uv run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="640" height="820" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1 · Conversation: works&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;TOWER_URL = the Runtime URL from deploy/.env.aws&lt;br&gt;TOWER_BEARER must be a JWT; D21: an empty discovery URL means every call gets 401&lt;br&gt;X-Tower-User is ignored on AWS: Asish only, no persona switch (decision 3)&lt;br&gt;Bedrock with the att profile, or ScriptedAgent; the pill shows mode + ENV=aws&lt;br&gt;macros off: they need pane 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="190" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2 · Carrier controls, Reset, macros: off&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;local-only by decision (2): no SSM tunnel is planned&lt;br&gt;MOCK_URL is empty (render_env.py)&lt;br&gt;the ALB is internal and never forwards /_admin (modules/mock_carrier/main.tf)&lt;br&gt;the pane says why, greyed out; no request goes to an empty URL&lt;br&gt;the demo's carrier moments run on ENV=local&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=11;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3 · Live feed: audit only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DynamoDB with the att profile; DYNAMO_ENDPOINT empty; TOWER_TABLE_PREFIX from .env.aws&lt;br&gt;polled every 5 s: about 3 reads/s while the page is open, cents per day&lt;br&gt;SMS: no laptop read path (Lambda + SNS); the text lands on the real phone&lt;br&gt;the audit row with message_ref is the evidence on screen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="610" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4 · Binding: QR code from next_step only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/_admin/* answers 404 on AWS (config.py): no grants list, no revoke from the UI&lt;br&gt;the bind link comes from Tower's NOT_BOUND next_step.url (next_step.py)&lt;br&gt;grants and revokes happen on the resident's own phone at /me (routes/grants.py)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="820" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="z_aws" value="AWS account (the demo UI is not in it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="930" height="900" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="&lt;b&gt;Bedrock Converse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;us-east-1 · BEDROCK_MODEL_ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="190" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Tower on AgentCore Runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;MCP over HTTPS · JWT sub → user_id&lt;br&gt;Gateway + Identity → mock (unchanged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="280" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mock" value="&lt;b&gt;Mock carrier on Fargate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;internal ALB: CAMARA prefixes and /oauth2 only&lt;br&gt;/_admin/* reachable only inside the task&lt;br&gt;ECS Exec enabled (aws_seed.py uses it)&lt;br&gt;no tunnel to the laptop (decision 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="400" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="&lt;b&gt;DynamoDB (Lines, Audit)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Query Lines by_owner · Query Audit, read as owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="610" width="420" height="80" as="geometry" />
