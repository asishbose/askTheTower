  <diagram id="11_ops" name="3 Pane 5 Ops">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_main" value="11 · Pane 5 (Ops): run the local stack from the browser, watch the AWS pipeline, never touch AWS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="1900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_sub" value="Specified 2026-10-11 (prompt 22, O1–O7, U3). The runner starts only the eleven allowlisted local make targets; the checklist reads files make wrote and probes URLs without a bearer." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t_sub2" value="Teal = the runner (local) · amber = the checklist (read only) · dashed zone = the allowlist boundary · pale dashed = never from the UI (O2): the human runs those in a terminal." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="66" width="1900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="z_laptop" value="Presenter's laptop (make showcase-ui on the host)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="1270" height="820" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser: pane 5 inside &amp;lt;details&amp;gt;, closed by default&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;POST /ops/run/{name} · POST /ops/stop (HX-Request + same Origin) · GET /fragment/ops, /fragment/ops-checklist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="z_ui" value="services/demo-ui" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E1726;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="640" height="600" as="geometry" />
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;5a · Run here (ops/runner.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;on only with ENV=local, the host run (not the compose/kind container),&lt;br&gt;make on PATH and the checkout found; otherwise greyed with the reason&lt;br&gt;one job at a time, shared lock with the macros: a second run → 409&lt;br&gt;asyncio exec, shell=False, stdin closed, own process group, cwd = checkout&lt;br&gt;env built from an allow-list (base · docker · uv); AWS_*, TF_VAR_*, *_TOKEN,&lt;br&gt;*_BEARER, *_SECRET, *_PASSWORD, *_KEY, ENV can never pass&lt;br&gt;lines → redact.mask + mask_secrets → ops frames on GET /events (O6)&lt;br&gt;Stop: SIGINT → 1.5 s SIGTERM → 2 s SIGKILL · badge pass|fail|stopped, code, time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="580" height="230" as="geometry" />
        </mxCell>
        <mxCell id="chk" value="&lt;b&gt;5b · AWS pipeline (ops/aws_status.py), read only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;1 ECR repositories · 2 images pushed · 3 deployed (healthz)&lt;br&gt;4 users seeded · 5 web chat live · 6 admin path on|off · 7 AWS test report&lt;br&gt;states todo · done · warn · fail · off; &quot;Nothing deployed yet&quot; when all todo&lt;br&gt;each step: the exact terminal command + a copy button (ops.js)&lt;br&gt;re-check on load, every 15 s and on the button; probes 2 s, cached 5 s&lt;br&gt;no boto3, no subprocess, no aws, no terraform, no bearer; never raises&lt;br&gt;with ENV=aws: the only live column (U3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="550" width="580" height="270" as="geometry" />
        </mxCell>
        <mxCell id="z_allow" value="Allowlist boundary: ops/allowlist.py (frozen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#2BB3A0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="240" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="allow" value="&lt;b&gt;make &amp;lt;target&amp;gt; ENV=local (eleven targets)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;stack: up · down · seed&lt;br&gt;demo: demo · showcase-tower · showcase-alerts · showcase-binding&lt;br&gt;tests: test-unit · test-integration · test-e2e · test-report&lt;br&gt;argv fixed in code; ENV=local beats ENV=aws in the root .env&lt;br&gt;changing it = allowlist.py + doc 11 §2 table (snapshot test)&lt;br&gt;the child make still reads the root .env itself, as in a terminal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="290" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="files" value="&lt;b&gt;Files make wrote (gitignored), read only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;artifacts/tf-outputs-ecr.json (make ecr-up)&lt;br&gt;artifacts/image-tag (make push)&lt;br&gt;deploy/.env.aws (make outputs): URLs; DEMO_ADMIN_BEARER only when open&lt;br&gt;artifacts/cognito-users.json (make cognito-users)&lt;br&gt;artifacts/seed-aws.json (make seed-aws, new)&lt;br&gt;artifacts/web-chat-sync.json (make web-chat-sync, new)&lt;br&gt;artifacts/test-report.md (make test-report)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
