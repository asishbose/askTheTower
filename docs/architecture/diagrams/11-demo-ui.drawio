        <mxCell id="z_aws" value="AWS: Bedrock only (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E0;strokeColor=#E8A33D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1470" y="250" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="&lt;b&gt;Bedrock Converse (tool use)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;BEDROCK_MODEL_ID (amazon.nova-micro-v1:0) · AWS_PROFILE&lt;br&gt;the repo's only model call stays in ref_client/agent.py&lt;br&gt;absent → ScriptedAgent; free text turned off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
