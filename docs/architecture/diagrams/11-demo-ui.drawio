        <mxCell id="e_phone" value="GET /bind/{token}?as=phone-asish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="phone" target="binding">
          <mxGeometry relative="1" as="geometry" x="-0.6154" />
        </mxCell>
        <mxCell id="never" value="&lt;b&gt;Never (doc 11 §8)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 decides nothing: no tower_policy, no camara_client, no CAMARA path; chips are Tower's reason_codes · 2 never calls the carrier or the gateway, only the mock's /_admin (a simulation aid)&lt;br&gt;3 never sends, receives or renders a phone number (refs on the wire, filter on the way out) · 4 writes no consent: grants go through the binding page; Reset is the make seed code&lt;br&gt;5 reads an audit only as its line's owner · 6 cannot make Alexa+ speak first · 7 is never deployed to AWS: no ECR repository, no Terraform, values-eks enabled=false · 8 adds nothing to the hot path&lt;br&gt;Captions, not hidden: D1 (link not texted → QR code) · D15 remainder (the line-holder's own UNREACHABLE copy; withheld in the demo run anyway)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
