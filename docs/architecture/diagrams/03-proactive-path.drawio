<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device"><diagram id="03_proactive_path" name="03 Proactive Path"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1342" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_main" value="Path B — a watched line changes → the consented second person is texted" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#1B2B45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="Alexa+ is not on this path. Event-driven where the carrier offers subscriptions; polled where it does not." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7A90;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1540" height="22" as="geometry"/></mxCell><mxCell id="p_car" value="Carrier&lt;br&gt;(mock / sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p1" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="141" as="sourcePoint"/><mxPoint x="140.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p_sched" value="EventBridge&lt;br&gt;Scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p2" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="141" as="sourcePoint"/><mxPoint x="380.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p_al" value="Alerts&lt;br&gt;(Lambda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p3" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="141" as="sourcePoint"/><mxPoint x="620.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p_gw" value="Carrier gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p4" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840.0" y="141" as="sourcePoint"/><mxPoint x="840.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p_ddb" value="DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p5" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060.0" y="141" as="sourcePoint"/><mxPoint x="1060.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p_sns" value="SNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p6" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280.0" y="141" as="sourcePoint"/><mxPoint x="1280.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ph_w" value="Watcher&#x27;s phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8A33D;strokeColor=#E8A33D;fontSize=11;fontColor=#0E1726;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="95" width="160" height="46" as="geometry"/></mxCell><mxCell id="p7" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1490" y="141" as="sourcePoint"/><mxPoint x="1490" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p8" value="1a · CloudEvent: sim-swap on line (sink token)" style="edgeStyle=none;html=1;strokeColor=#E8A33D;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="175" as="sourcePoint"/><mxPoint x="620.0" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9" value="1b · poll(profile=care)  — fallback" style="edgeStyle=none;html=1;strokeColor=#E8A33D;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="210" as="sourcePoint"/><mxPoint x="620.0" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p10" value="load Watch (last_state, escalation, profile)" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="260" as="sourcePoint"/><mxPoint x="1060.0" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11" value="" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060.0" y="295" as="sourcePoint"/><mxPoint x="620.0" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p12" value="sim_swap_check · call_forwarding (5 s budget, 1 retry)" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="335" as="sourcePoint"/><mxPoint x="840.0" y="335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p13" value="CAMARA calls" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840.0" y="370" as="sourcePoint"/><mxPoint x="140.0" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p14" value="Facts" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="405" as="sourcePoint"/><mxPoint x="620.0" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n420p_al" value="policy.evaluate_line → changed&lt;br&gt;compare with last_state → new change?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="634.0" y="420" width="250" height="44" as="geometry"/></mxCell><mxCell id="p15" value="resolve(watcher, alias) — re-check the grant" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="490" as="sourcePoint"/><mxPoint x="1060.0" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p16" value="grant: watch  (revoked → SUPPRESSED_REVOKED, stop)" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060.0" y="525" as="sourcePoint"/><mxPoint x="620.0" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p17" value="publish(templated SMS, escalation[0])" style="edgeStyle=none;html=1;strokeColor=#E8A33D;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="575" as="sourcePoint"/><mxPoint x="1280.0" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p18" value="&quot;Mom&#x27;s SIM moved at 7:40 — if that wasn&#x27;t her, call the carrier.&quot;" style="edgeStyle=none;html=1;strokeColor=#E8A33D;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280.0" y="610" as="sourcePoint"/><mxPoint x="1490" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n625p_al" value="never to the swapped line itself;&lt;br&gt;line-holder&#x27;s backup phone instead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="634.0" y="625" width="250" height="44" as="geometry"/></mxCell><mxCell id="p19" value="Watches.last_state ← facts · audit.append(actor=system:alerts)" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="700" as="sourcePoint"/><mxPoint x="1060.0" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n715p_al" value="no ack in 15 min (where required)&lt;br&gt;→ escalation[1] …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="634.0" y="715" width="250" height="44" as="geometry"/></mxCell><mxCell id="pr_n" value="Rate: at most one alert per line per reason per 6 h. Reachability profiles: care = 4 h dark in the daytime window; transplant = 20 min dark, subscription-first with 5-min poll fallback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#6B7A90;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1520" height="40" as="geometry"/></mxCell><!-- gen_extend:begin --><mxCell id="x_zone" value="Ack and revoke branches, as built (06 §3–§4) — added by gen_extend.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E0;strokeColor=#E8A33D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=13;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="28" y="940" width="1544" height="372" as="geometry" /></mxCell><mxCell id="x_reply" value="&lt;b&gt;Watcher replies OK / CANCEL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SMS reply → SNS inbound topic → Alerts handler → handle_reply (escalation.py:175)&lt;br&gt;the number is hashed to a line_id at once&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_swapq" value="&lt;b&gt;Replying line SIM-swapped &amp;lt; 24 h?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ACK_DISTRUST: its Watch state, else a SIM Swap check; a carrier error counts as swapped (escalation.py:161)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="432" y="980" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_ok" value="&lt;b&gt;no → accepted&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;audit ok · OK; the parked escalation is cleared; escalation[1] is never texted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="980" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_ign" value="&lt;b&gt;yes → ACK_IGNORED_SWAPPED_LINE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;audited; the chain keeps waiting as if unacknowledged (escalation.py:207)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C57B7B;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="1068" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_tick" value="&lt;b&gt;15 min without a valid ack → escalation[1]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tick (every poll + rate(5 min)): re-read grant → audit changed → SMS; adds “A reply from the affected line was ignored.”&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="1216" y="1068" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8A33D;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_reply" target="x_swapq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_swapq" target="x_ok"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="x_e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C57B7B;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_swapq" target="x_ign"><mxGeometry relative="1" as="geometry" x="-0.1022"><Array as="points"><mxPoint x="603" y="1103" /></Array><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="x_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E8A33D;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_ign" target="x_tick"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_rev" value="&lt;b&gt;Line-holder revokes the grant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;binding page POST /grants/{id}/revoke → Grants.revoked_at (grants.py:142, tower_consent grants.py:89)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="1156" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_reread" value="&lt;b&gt;Re-read just before any send&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;deliver() (send.py:173) and the tick (escalation.py:118) resolve the watcher's grant again&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="432" y="1156" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_supp" value="&lt;b&gt;SUPPRESSED_REVOKED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;audit suppressed; nothing sent; no rate claim; a parked escalation is cleared&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C57B7B;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="1156" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_poll" value="&lt;b&gt;Already revoked at evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;no carrier call; on an event one SUPPRESSED_REVOKED row, on a poll no row (runner.py:45)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="1216" y="1156" width="342" height="70" as="geometry" /></mxCell><mxCell id="x_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_rev" target="x_reread"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_e6" value="revoked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C57B7B;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_reread" target="x_supp"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="x_note" value="&lt;font style=&quot;font-size:10px&quot;&gt;As built the order is re-resolve → rate limit → audit → SMS (send.py:173–216): the audit row exists before any text. The arrow “Watches.last_state ← facts · audit.append” above is drawn after the send (code-vs-docs.md D10).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=10;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="60" y="1256" width="1480" height="36" as="geometry" /></mxCell><!-- gen_extend:end --></root></mxGraphModel></diagram></mxfile>