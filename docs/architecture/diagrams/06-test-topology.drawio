<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device"><diagram id="06_test_and_showcase_topology" name="06 Test and Showcase Topology"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_main" value="Testing and showcase — each component proven alone, then the whole" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#1B2B45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="Numbers are the showcase order from testing-and-showcase.md §4. Fixture everywhere: the mock and its admin API." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7A90;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1540" height="22" as="geometry"/></mxCell><mxCell id="t_fix" value="Fixture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E0;strokeColor=#E8A33D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1520" height="90" as="geometry"/></mxCell><mxCell id="t_mock" value="Mock carrier · scenarios/demo.yaml · clock · admin events · faults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="1480" height="44" as="geometry"/></mxCell><mxCell id="s1" value="① Mock&lt;br&gt;/docs · load scenario · advance clock 12 min → swapped&lt;br&gt;proves: conformance, determinism" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="480" height="110" as="geometry"/></mxCell><mxCell id="s2" value="② Policy table&lt;br&gt;make policy-table&lt;br&gt;proves: every decision, no model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="560" y="220" width="480" height="110" as="geometry"/></mxCell><mxCell id="s3" value="③ Binding&lt;br&gt;phone, Wi-Fi off, one tap · grant · revoke&lt;br&gt;proves: nothing typed, grants real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1060" y="220" width="480" height="110" as="geometry"/></mxCell><mxCell id="s4" value="④ Moment 1 — dead phone&lt;br&gt;simulator → Tower → mock (+12 min)&lt;br&gt;proves: hot path, phrasing, latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="480" height="110" as="geometry"/></mxCell><mxCell id="s5" value="⑤ Moment 2 — forwarded line&lt;br&gt;cf_set on mock → answer&lt;br&gt;proves: second API, same shape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="480" height="110" as="geometry"/></mxCell><mxCell id="s6" value="⑥ Moment 3 — Mom&#x27;s line&lt;br&gt;watch → sim_swap → phone buzzes → revoke → suppressed&lt;br&gt;proves: proactive path, consent live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="480" height="110" as="geometry"/></mxCell><mxCell id="s7" value="⑦ Transplant closing&lt;br&gt;transplant profile · 20 min dark → partner texted · +15 → second contact&lt;br&gt;proves: window arithmetic, escalation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="480" height="110" as="geometry"/></mxCell><mxCell id="s8" value="⑧ Audit&lt;br&gt;Mom&#x27;s view · chain verified · &quot;who checked my line?&quot;&lt;br&gt;proves: append-before-release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="480" height="110" as="geometry"/></mxCell><mxCell id="s9" value="⑨ make demo&lt;br&gt;reference client runs 4–7 from the terminal&lt;br&gt;proves: a judge can run it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="480" height="110" as="geometry"/></mxCell><mxCell id="t_layers" value="Test layers (CI unless noted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F5;strokeColor=#9AA7B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1520" height="250" as="geometry"/></mxCell><mxCell id="l1" value="Unit&lt;br&gt;policy cross-product · templates&lt;br&gt;consent resolve · HMAC · windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="280" height="100" as="geometry"/></mxCell><mxCell id="l2" value="Contract&lt;br&gt;Tower↔consent · Tower↔CarrierClient (both)&lt;br&gt;Alerts↔SNS stub · page↔carrier auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="360" y="700" width="280" height="100" as="geometry"/></mxCell><mxCell id="l3" value="Conformance&lt;br&gt;mock vs specs (schemathesis)&lt;br&gt;fixtures via Direct and Gateway (nightly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="280" height="100" as="geometry"/></mxCell><mxCell id="l4" value="Privacy&lt;br&gt;no E.164 / health words in logs,&lt;br&gt;results, SMS; no line_id on metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="280" height="100" as="geometry"/></mxCell><mxCell id="l5" value="Latency (CI) + chaos (nightly)&lt;br&gt;200 calls/tool p95 &lt; 400 ms&lt;br&gt;faults → STALE_DATA, never wrong" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1260" y="700" width="280" height="100" as="geometry"/></mxCell><mxCell id="l6" value="End to end — make demo: three moments + transplant via the reference client; transcripts match golden files. CI locally, on AWS before submission." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><