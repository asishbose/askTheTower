        <mxCell id="b0_r2" value="&lt;b&gt;EXIT · NOT_BOUND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;engine.py:28 — before any fact, so nothing about the line leaks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C57B7B;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
