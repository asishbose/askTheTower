<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device">
  <diagram id="09_refusal_paths" name="09 Refusal Paths">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2104" pageHeight="1104" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_main" value="Refusal paths — the five ways a tool call ends without an answer about the line" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="2044" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t_sub" value="line_is_ok shown; is_reachable and watch_line share steps 1–3 and 6–7. Each column is one exit: where it leaves, the code that decides it, and the sentence Alexa+ is handed. Alexa+ phrases; it never decides." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="2044" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t_sub2" value="Pink = the exit. Dashed = not reached. Teal arrows = the path taken; red = straight to the result after a consent exit. D-numbers point to docs/architecture/code-vs-docs.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="66" width="2044" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lane_h" value="Step (02 §2, as built)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="112" width="240" height="46" as="geometry" />
        </mxCell>
        <mxCell id="lane0" value="&lt;b&gt;1 · identity → user_id&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;auth.py Authenticator.authenticate; no identity → HTTP 401, not an envelope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="172" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lane1" value="&lt;b&gt;2 · consent.resolve(user_id, line)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;one Query (resolve.py:47); store down → SERVICE_UNAVAILABLE (common.py:88)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="262" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="&lt;b&gt;3 · consent gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;policy's own first rules (engine.py:27) via common.consent_gate (common.py:109)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="352" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="&lt;b&gt;4 · facts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Watch.last_state if ≤ FRESH 10 min, else SIM swap ‖ call forwarding, 300 ms each, no retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="442" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lane4" value="&lt;b&gt;5 · evaluate_line(facts, consent, now)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pure; carrier error is checked before staleness (engine.py:35)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="532" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lane5" value="&lt;b&gt;6 · audit.append — blocks the answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;chain-head GetItem + TransactWriteItems (writer.py:77)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="622" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lane6" value="&lt;b&gt;7 · ToolResult → Alexa+&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;summary · facts · reason_codes · next_step · checked_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="712" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lane_says" value="&lt;b&gt;What Alexa+ is handed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;summary, from tower_policy/phrasing.py TEMPLATES (03 §4)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
