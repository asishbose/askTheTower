        <mxCell id="lane_note" value="&lt;b&gt;As built&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;what differs from the docs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
