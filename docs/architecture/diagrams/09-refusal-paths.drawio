        <mxCell id="b0_h" value="1 · NOT_BOUND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;spacing=4;" vertex="1" parent="1">
