        <mxCell id="ecr" value="&lt;b&gt;ECR — aws_ecr_repository.service ×5 (deploy/terraform/ecr/main.tf)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;att-dev/tower-mcp · att-dev/mock-carrier · att-dev/binding-page · att-dev/alerts · att-dev/ref-client&lt;br&gt;aws_ecr_lifecycle_policy.service (keep the last 10) · scan on push · AES256 · force_delete = true&lt;br&gt;tags &amp;lt;git sha&amp;gt; + latest, single-manifest linux/arm64; pulled by Runtime, Lambda ×3 and the ECS task&lt;br&gt;make ecr-up creates (once) · make down ENV=aws keeps · make down-all is the only deleter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="1925" width="900" height="135" as="geometry" />
        </mxCell>
        <mxCell id="ecr_read" value="&lt;b&gt;Main root reads it — data &quot;aws_ecr_repository&quot;.service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;for_each over the five services, by name &amp;lt;name_prefix&amp;gt;-&amp;lt;environment&amp;gt;/&amp;lt;service&amp;gt;;&lt;br&gt;local.images = &amp;lt;repository_url&amp;gt;:&amp;lt;image_tag&amp;gt; → Runtime, Lambda ×3, ECS task.&lt;br&gt;Output ecr_repositories kept (push_images.py, the eks root). image_tag = the tag&lt;br&gt;the last make push recorded (artifacts/image-tag); deploy verifies it in ECR first.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1925" width="700" height="135" as="geometry" />
        </mxCell>
        <mxCell id="d_env" value="&lt;b&gt;root .env + envs/aws.tfvars&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mk/vars.mk exports every non-empty .env key:&lt;br&gt;AWS keys of IAM user ask-the-tower-dev, TF_VAR_*&lt;br&gt;envs/aws.tfvars (gitignored): mock_domain_name,&lt;br&gt;mock_route53_zone_id, tower_jwt_*, sms numbers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="2175" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d_make" value="&lt;b&gt;make — mk/aws.mk, mk/build.mk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ecr-up · ecr-outputs · plan · deploy · outputs&lt;br&gt;register-gateway · seed-aws · latency-aws&lt;br&gt;build · push ENV=aws · down ENV=aws · down-all&lt;br&gt;image_tag = artifacts/image-tag on plan / deploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="2175" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d_buildx" value="&lt;b&gt;docker buildx (scripts/push_images.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;docker buildx build --platform linux/arm64&lt;br&gt;--provenance=false --sbom=false --push&lt;br&gt;-t &amp;lt;repo&amp;gt;:&amp;lt;sha&amp;gt; -t &amp;lt;repo&amp;gt;:latest · QEMU binfmt&lt;br&gt;(make build images are host-arch, not pushed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
