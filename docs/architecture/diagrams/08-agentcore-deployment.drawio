        <mxCell id="l_bind" value="&lt;b&gt;Lambda — binding page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;aws_lambda_function.fn[&quot;binding-page&quot;]&lt;br&gt;image att-dev/binding-page:&amp;lt;sha&amp;gt; · arm64&lt;br&gt;awslambdaric binding_page.app.handler&lt;br&gt;role aws_iam_role.fn: DynamoDB, KMS, Gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="830" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l_rec" value="&lt;b&gt;Lambda — reconcile (nightly)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;aws_lambda_function.fn[&quot;reconcile&quot;]&lt;br&gt;image att-dev/alerts:&amp;lt;sha&amp;gt; (same image)&lt;br&gt;tower_audit.aws.reconcile_handler&lt;br&gt;Logs Insights over aws/spans; trims Audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="975" width="320" height="115" as="geometry" />
        </mxCell>
        <mxCell id="l_alerts" value="&lt;b&gt;Lambda — alerts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;aws_lambda_function.fn[&quot;alerts&quot;]&lt;br&gt;image att-dev/alerts:&amp;lt;sha&amp;gt; · arm64&lt;br&gt;alerts.handler.lambda_handler: hooks,&lt;br&gt;/internal/watch, polls, ticks, SMS replies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="1115" width="320" height="115" as="geometry" />
