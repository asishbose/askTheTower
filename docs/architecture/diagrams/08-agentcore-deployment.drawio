        <mxCell id="alb" value="&lt;b&gt;Internal ALB — mock carrier front&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/mock_carrier → aws_lb.this (internal)&lt;br&gt;aws_lb_listener.this HTTPS :443 →&lt;br&gt;aws_lb_target_group.this HTTP :8443&lt;br&gt;aws_acm_certificate.this (DNS-validated)&lt;br&gt;aws_route53_record.alb (mock_domain_name)&lt;br&gt;forwards CAMARA paths, /oauth2/*,&lt;br&gt;/.well-known/*, /healthz — never /_admin/*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
