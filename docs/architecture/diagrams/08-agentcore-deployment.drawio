        <mxCell id="t1" value="Ask the Tower on Amazon Bedrock AgentCore — the AWS account after &lt;code&gt;make deploy&lt;/code&gt; (as the repo builds it today)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="2860" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Every box names the Terraform module / resource that creates it and the image it runs (tag = git sha from &lt;code&gt;make push&lt;/code&gt;). Teal = request path (Alexa+ → Runtime → Gateway → mock; web chat W1–W5), amber = proactive path (mock → API → Alerts → SNS), grey = binding, data and management, dashed = deploy-time or deferred, pale = intended or optional, not deployed by default." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="2860" height="22" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Status: written and &lt;code&gt;terraform validate&lt;/code&gt;-clean; never planned or applied (docs/submission/build-log/13.md). Region us-east-1, name prefix &lt;code&gt;att-dev&lt;/code&gt; (name_prefix + environment), tag &lt;code&gt;project=ask-the-tower&lt;/code&gt; on everything." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
