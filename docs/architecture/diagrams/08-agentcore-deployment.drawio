        </mxCell>
        <mxCell id="watcher" value="&lt;b&gt;Watcher's phone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;receives the templated SMS&lt;br&gt;never the number just swapped&lt;br&gt;must be a verified SNS sandbox number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1380" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sandbox" value="&lt;b&gt;Carrier sandbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;carrier_backend = &quot;sandbox&quot;:&lt;br&gt;mock_carrier count = 0; Gateway&lt;br&gt;targets' servers[0] = sandbox_base_url;&lt;br&gt;Identity holds sandbox_client_id and&lt;br&gt;TF_VAR_sandbox_client_secret&lt;br&gt;(public HTTPS, no VPC resource)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=11;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="2640" y="820" width="230" height="170" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;AgentCore Runtime — Tower MCP server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/agentcore_runtime&lt;br&gt;aws_bedrockagentcore_agent_runtime.tower&lt;br&gt;image att-dev/tower-mcp:&amp;lt;git sha&amp;gt; (linux/arm64)&lt;br&gt;server_protocol MCP · :8000/mcp, stateless&lt;br&gt;network_mode PUBLIC (VPC on the cut line)&lt;br&gt;inbound: custom_jwt_authorizer (Cognito&lt;br&gt;discovery URL); Authorization header&lt;br&gt;allow-listed, Tower re-verifies, sub → user_id&lt;br&gt;aws_iam_role.runtime: ECR pull, logs, X-Ray,&lt;br&gt;DynamoDB, KMS, InvokeGateway&lt;br&gt;aws_cloudwatch_log_group.tower&lt;br&gt;output tower_mcp_url (?qualifier=DEFAULT)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="320" height="295" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;AgentCore Gateway — CAMARA as MCP tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/agentcore_gateway&lt;br&gt;aws_bedrockagentcore_gateway.this&lt;br&gt;authorizer_type AWS_IAM · protocol MCP&lt;br&gt;6 × aws_bedrockagentcore_gateway_target&lt;br&gt;.camara — one per specs/camara/*.yaml,&lt;br&gt;inline OpenAPI, servers → carrier URL&lt;br&gt;tools &amp;lt;target&amp;gt;___&amp;lt;operationId&amp;gt;&lt;br&gt;outbound OAuth: CLIENT_CREDENTIALS;&lt;br&gt;AUTHORIZATION_CODE (number-verification)&lt;br&gt;private_endpoint: managed VPC resource&lt;br&gt;aws_iam_role.gateway&lt;br&gt;outputs gateway_url, gateway_target_ids&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="200" width="320" height="295" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;AgentCore Identity — outbound carrier OAuth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/agentcore_identity&lt;br&gt;2 × aws_bedrockagentcore_oauth2_credential_&lt;br&gt;provider.this (CustomOauth2):&lt;br&gt;· service — client credentials, client &quot;tower&quot;&lt;br&gt;· binding — auth code, client &quot;binding-page&quot;&lt;br&gt;client_secret_basic; token URL&lt;br&gt;https://&amp;lt;mock_domain_name&amp;gt;/oauth2/token&lt;br&gt;private_endpoint: managed VPC resource&lt;br&gt;aws_bedrockagentcore_workload_identity&lt;br&gt;.binding (return URL …/bind/callback)&lt;br&gt;the only holder of carrier secrets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="200" width="340" height="295" as="geometry" />
        </mxCell>
        <mxCell id="obs" value="&lt;b&gt;Observability — CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/observability&lt;br&gt;aws_cloudwatch_dashboard.this&lt;br&gt;(p95 per tool, alerts, reconcile misses)&lt;br&gt;aws_cloudwatch_log_metric_filter.alerts,&lt;br&gt;.line_id_on_metric (guard)&lt;br&gt;aws_cloudwatch_metric_alarm ×3&lt;br&gt;traces: aws/spans via CloudWatch&lt;br&gt;Transaction Search + ADOT in Tower —&lt;br&gt;both by hand: TODO(human) build-log/13&lt;br&gt;no metric carries line_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1820" y="200" width="340" height="295" as="geometry" />
        </mxCell>
        <mxCell id="refclient" value="&lt;b&gt;AgentCore Runtime — web chat agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;aws_bedrockagentcore_agent_runtime.ref_client&lt;br&gt;(enable_web_chat, default true)&lt;br&gt;image att-dev/ref-client:&amp;lt;git sha&amp;gt;, HTTP app&lt;br&gt;server_protocol HTTP · :8080 POST /invocations,&lt;br&gt;GET /ping (09 §6)&lt;br&gt;inbound: custom_jwt_authorizer (Cognito,&lt;br&gt;allowed_clients web-chat); Authorization&lt;br&gt;allow-listed and forwarded to Tower unchanged&lt;br&gt;aws_iam_role.agent: Bedrock invoke + logs only&lt;br&gt;(no DynamoDB, KMS or Gateway — 09 §5)&lt;br&gt;env TOWER_URL, WEB_CHAT_BINDING_BASE_URL&lt;br&gt;TODO(human) build-log/20 · F9 being resolved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="2200" y="200" width="340" height="295" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="&lt;b&gt;DynamoDB on-demand — 7 tables&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/dynamodb → aws_dynamodb_table.this (for_each over tables.auto.tfvars.json)&lt;br&gt;att-dev-Users · Lines · Grants · Watches · Audit (PITR) · BindTokens (TTL) · AlertsState (TTL)&lt;br&gt;SSE with aws_kms_key.main · keys are HMAC line_id, never a number&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="595" width="560" height="125" as="geometry" />
        </mxCell>
        <mxCell id="tfsecrets" value="&lt;b&gt;Generated secrets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;random_password&lt;br&gt;.carrier_client ×3,&lt;br&gt;.internal_bearer,&lt;br&gt;.session_secret — in&lt;br&gt;encrypted S3 state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1085" y="595" width="180" height="125" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;aws_secretsmanager_secret.registry&lt;br&gt;(modules/mock_carrier): the mock's own&lt;br&gt;client registry + JWT secret; recovery 0 d&lt;br&gt;nothing carrier-side the consumer holds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1840" y="595" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="kms" value="&lt;b&gt;KMS — two keys&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/kms → aws_kms_key.main (symmetric,&lt;br&gt;rotation on: msisdn_enc, logs, SNS, tables)&lt;br&gt;aws_kms_key.hmac (HMAC_256: line_id)&lt;br&gt;aliases; key policy: Runtime + 3 Lambda roles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="2200" y="595" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="cf" value="&lt;b&gt;CloudFront + WAF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;aws_cloudfront_distribution.this&lt;br&gt;aws_wafv2_web_acl.edge&lt;br&gt;(rate rule on /hooks/*)&lt;br&gt;modules/lambdas&lt;br&gt;= public_base_url&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="830" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API Gateway HTTP API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;aws_apigatewayv2_api.this, stage&lt;br&gt;$default → binding-page&lt;br&gt;ANY /hooks/{proxy+} → alerts&lt;br&gt;ANY /internal/{proxy+} → alerts&lt;br&gt;GET /carrier/oauth2/authorize&lt;br&gt;→ VPC link → mock ALB&lt;br&gt;outputs binding_url, hooks_base_url&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="830" width="260" height="200" as="geometry" />
