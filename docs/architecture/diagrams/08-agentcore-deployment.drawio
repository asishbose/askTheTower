        <mxCell id="d_files" value="&lt;b&gt;Generated files (gitignored)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;artifacts/tf-outputs.json · tf-outputs-ecr.json · image-tag&lt;br&gt;artifacts/tfplan · terraform-plan.txt · gateway-tools.json&lt;br&gt;deploy/.env.aws (endpoints for ENV=aws targets, no secrets)&lt;br&gt;artifacts/latency-aws.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
