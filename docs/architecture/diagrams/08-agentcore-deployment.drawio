        <mxCell id="r5c2" value="&lt;font style=&quot;font-size:9px&quot;&gt;MCP · Bearer (TOWER_JWT†); SigV4 only if no JWT authorizer is configured&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="336" y="470" width="330" height="74" as="geometry" />
        </mxCell>
        <mxCell id="r5c3" value="&lt;font style=&quot;font-size:9px&quot;&gt;output tower_mcp_url → render_env.py → TOWER_URL in deploy/.env.aws → ref-client, scripts/latency.py; TOWER_JWT† from the root .env&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
