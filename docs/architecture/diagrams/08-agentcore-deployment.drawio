        </mxCell>
        <mxCell id="d_tf" value="&lt;b&gt;terraform ≥ 1.9 · aws ≥ 6.20, &amp;lt; 7 · random&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;-chdir=deploy/terraform and …/ecr (two states)&lt;br&gt;S3 backend (backend.tf), lock table&lt;br&gt;apply / destroy as the IAM user&lt;br&gt;make tf-check: init -backend=false + validate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="2175" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d_scripts" value="&lt;b&gt;scripts/ (uv run python)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;register_gateway.py · aws_seed.py&lt;br&gt;render_env.py · latency.py · push_images.py&lt;br&gt;read artifacts/tf-outputs.json (_tf_outputs.py);&lt;br&gt;push falls back to tf-outputs-ecr.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
