        <mxCell id="s13_aws" value="&lt;b&gt;what remains&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;5 ECR repositories + images,&lt;br&gt;S3 state + lock table,&lt;br&gt;Route 53 zone, SMS sandbox numbers,&lt;br&gt;KMS keys (pending), AWS-made log&lt;br&gt;groups — tag project=ask-the-tower&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#E8A33D;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="3554" y="1212" width="270" height="206" as="geometry" />
        </mxCell>
        <mxCell id="v_s13_dev_s13_make" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s13_dev" target="s13_make">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v_s13_make_s13_tf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s13_make" target="s13_tf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v_s13_tf_s13_aws" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s13_tf" target="s13_aws">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_s12_dev" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2BB3A0;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.1626;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1626;entryDx=0;entryDy=0;" edge="1" parent="1" source="s12_dev" target="s13_dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="&lt;b&gt;ECR&lt;/b&gt;: its own root (step 2, make ecr-up), so make down ENV=aws keeps the repositories and images and a redeploy skips steps 2–4 unless the code changed; make down-all (EKS → main → ECR) is the only target that deletes images. &lt;b&gt;Image tag&lt;/b&gt;: make push records the pushed sha in artifacts/image-tag; plan and deploy use it (IMAGE_TAG= overrides) and deploy checks it exists in ECR before apply; down passes none, so a later commit cannot break any of the three. &lt;b&gt;Rollback&lt;/b&gt; for steps 5–12 is make down ENV=aws (main stack); there is no per-module destroy target. &lt;b&gt;Cut line&lt;/b&gt; (prompts/00): tower_carrier_client = &quot;direct&quot; + enable_nat_gateway = true in envs/aws.tfvars, then steps 5–6 again — see page 3." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="1450" width="3796" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="08_integrations" name="3 Integrations and config">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2338" pageHeight="1740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Integrations and config — every edge on page 1, where its settings come from, and what proves it" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1B2B45;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="2278" height="32" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Config travels two ways: Terraform variable / resource → module → service environment (Runtime environment_variables, Lambda environment, ECS task env); and Terraform output → make outputs → artifacts/tf-outputs.json → scripts/render_env.py → deploy/.env.aws → mk/vars.mk exports for ENV=aws targets." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="46" width="2278" height="22" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="† = env var not in any services/*/.env.example (finding F8 in the companion doc). Row colour: teal request path, amber proactive path, grey binding / data / management." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="68" width="2278" height="22" as="geometry" />
        </mxCell>
        <mxCell id="h0" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="44" height="34" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;Producer → consumer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E9F2;strokeColor=#0E1726;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
