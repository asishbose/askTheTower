        <mxCell id="wc_url" value="&lt;b&gt;Lambda function URL — proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/web_chat · zip proxy/handler.py&lt;br&gt;auth NONE; CORS = the page origin&lt;br&gt;forwards Authorization, Content-Type,&lt;br&gt;session header to the agent runtime only&lt;br&gt;output agent_url · no credential held&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
