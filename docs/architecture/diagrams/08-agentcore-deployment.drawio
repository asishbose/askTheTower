        <mxCell id="alexa" value="&lt;b&gt;Alexa+ MCP Toolkit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;web simulator · Amazon's cloud, not ours&lt;br&gt;MCP client; phrases results; never speaks first&lt;br&gt;registered with the output tower_mcp_url&lt;br&gt;+ OAuth account linking (Cognito)&lt;br&gt;TODO(human): alexa/registration.md §2–§6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="230" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="phone" value="&lt;b&gt;Line-holder's phone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mobile data, Wi-Fi off (rule 7)&lt;br&gt;opens the binding link and the carrier&lt;br&gt;authorize page; one tap&lt;br&gt;TODO(human): §2.6 real-phone run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=11;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
