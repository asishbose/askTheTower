        <mxCell id="z_cut" value="Cut-line variants (prompts/00) — not the default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=13;fontColor=#8A96A8;dashed=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1748" y="110" width="560" height="880" as="geometry" />
        </mxCell>
        <mxCell id="cut_a" value="&lt;b&gt;A · DirectClient from Runtime → Fargate mock (expressible today)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;envs/aws.tfvars: tower_carrier_client = &quot;direct&quot; + enable_nat_gateway = true&lt;br&gt;Runtime network_mode VPC (private subnets, agentcore_egress SG, NAT for ECR/logs)&lt;br&gt;Runtime env CARRIER_CLIENT=direct, CARRIER_SECRET_REF=env:CARRIER_CLIENT_SECRET,&lt;br&gt;CARRIER_CLIENT_SECRET — the documented exception: Tower's client secret is&lt;br&gt;Runtime config (tests/aws/test_terraform_static.py allows it only here)&lt;br&gt;Tower → mock: HTTPS + OAuth2 client credentials minted by the mock itself&lt;br&gt;Gateway and Identity are still created; alerts always uses Gateway;&lt;br&gt;binding uses it unless binding_carrier_client = &quot;direct&quot;&lt;br&gt;render_env.py still writes CARRIER_CLIENT=gateway (finding F7)&lt;br&gt;cost: + NAT gateway ≈ $0.045/h + data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=11;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1768" y="150" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="cut_rt" value="&lt;b&gt;Runtime (VPC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DirectClient&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=11;fontColor=#8A96A8;align=center;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
