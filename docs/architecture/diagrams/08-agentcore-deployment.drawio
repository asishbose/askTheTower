        </mxCell>
        <mxCell id="r2c1" value="&lt;b&gt;Browser → web chat page + Cognito Hosted UI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="250" height="74" as="geometry" />
        </mxCell>
        <mxCell id="r2c2" value="&lt;font style=&quot;font-size:9px&quot;&gt;HTTPS · CloudFront (OAC → private S3) · Cognito authorization code + PKCE, no client secret&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="336" y="230" width="330" height="74" as="geometry" />
        </mxCell>
        <mxCell id="r2c3" value="&lt;font style=&quot;font-size:9px&quot;&gt;module.web_chat page URL → Cognito client callback / logout URL; outputs cognito_hosted_ui_url, cognito_client_id, web_chat_url, agent_url, binding_url → make web-chat-sync → config.js keys COGNITO_DOMAIN, CLIENT_ID, REDIRECT_URI, AGENT_URL, BINDING_BASE_URL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
