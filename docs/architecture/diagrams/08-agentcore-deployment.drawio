        <mxCell id="cut_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B8C2CF;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cut_rt" target="cut_alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cut_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B8C2CF;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cut_alb" target="cut_mock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cut_gw" value="&lt;b&gt;Gateway + Identity (still deployed)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;used by alerts (always) and binding (unless direct) — not by Tower&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=11;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1768" y="520" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cut_b" value="&lt;b&gt;B · No Gateway / Identity at all (not expressible today)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;prompts/00: &quot;Gateway and Identity become a documented experiment&quot;&lt;br&gt;Terraform has no switch for it: modules agentcore_gateway and&lt;br&gt;agentcore_identity are unconditional, the alerts Lambda always gets&lt;br&gt;gateway_environment, and agentcore_runtime / lambdas take gateway_arn&lt;br&gt;Needs: count on both modules, a direct environment for alerts (secret&lt;br&gt;via Secrets Manager or env), binding_carrier_client = &quot;direct&quot; —&lt;br&gt;a Terraform change, not made here (finding F10)&lt;br&gt;What would remain: Runtime (VPC) + Fargate mock + Lambda ×3 + data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=11;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="1768" y="610" width="520" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cut_note" value="Either variant keeps the rules: policy stays deterministic code in Tower, Alexa+ only phrases, the mock stays the demo default, binding still needs the phone on mobile data, and the hot path stays one DynamoDB read plus the carrier calls." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#6B7A90;fontStyle=0;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1768" y="850" width="520" height="120" as="geometry" />
