<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device"><diagram id="02_request_path" name="02 Request Path"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1370" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_main" value="Path A — &quot;Alexa, is my line OK?&quot;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#1B2B45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1540" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="The hot path. No model between the question and the answer. Budget ≈ 300 ms p95 against the mock." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7A90;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1540" height="22" as="geometry"/></mxCell><mxCell id="c_alexa" value="Alexa+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p1" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="141" as="sourcePoint"/><mxPoint x="140.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_tower" value="Tower MCP&lt;br&gt;(Runtime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p2" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="141" as="sourcePoint"/><mxPoint x="400.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_ddb" value="DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p3" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="141" as="sourcePoint"/><mxPoint x="660.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_gw" value="Carrier gateway&lt;br&gt;(Gateway + Identity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p4" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920.0" y="141" as="sourcePoint"/><mxPoint x="920.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_car" value="Carrier&lt;br&gt;(mock / sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p5" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="141" as="sourcePoint"/><mxPoint x="1200.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c_pol" value="Policy&lt;br&gt;(in-process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E1726;strokeColor=#0E1726;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="95" width="200" height="46" as="geometry"/></mxCell><mxCell id="p6" value="" style="edgeStyle=none;html=1;strokeColor=#9AA7B5;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=none;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460.0" y="141" as="sourcePoint"/><mxPoint x="1460.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p7" value="line_is_ok(line=&quot;self&quot;) + identity" style="edgeStyle=none;html=1;strokeColor=#2BB3A0;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="175" as="sourcePoint"/><mxPoint x="400.0" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n190c_tower" value="identity → user_id (401 if absent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="414.0" y="190" width="230" height="30" as="geometry"/></mxCell><mxCell id="p8" value="resolve(user_id, &quot;self&quot;)" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="250" as="sourcePoint"/><mxPoint x="660.0" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9" value="{bound, grant:owner, line_id}" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="285" as="sourcePoint"/><mxPoint x="400.0" y="285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n300c_tower" value="NOT_BOUND? → refusal + binding URL, stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="414.0" y="300" width="230" height="30" as="geometry"/></mxCell><mxCell id="p10" value="sim_swap_check(line_id, 72h)   ‖   call_forwarding(line_id)" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="360" as="sourcePoint"/><mxPoint x="920.0" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n375c_gw" value="Identity injects carrier bearer&lt;br&gt;number decrypted inside the call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="934.0" y="375" width="230" height="44" as="geometry"/></mxCell><mxCell id="p11" value="POST /sim-swap/check · POST /call-forwarding-signal/…" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920.0" y="440" as="sourcePoint"/><mxPoint x="1200.0" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p12" value="{swapped:true, latestSimChange} · {active:false}" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="475" as="sourcePoint"/><mxPoint x="920.0" y="475" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p13" value="Facts (booleans + timestamps)" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920.0" y="510" as="sourcePoint"/><mxPoint x="400.0" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p14" value="evaluate_line(facts, consent, now)" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="560" as="sourcePoint"/><mxPoint x="1460.0" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p15" value="changed · [SIM_SWAPPED_RECENT]" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460.0" y="595" as="sourcePoint"/><mxPoint x="400.0" y="595" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p16" value="audit.append(...)  — blocks the response" style="edgeStyle=none;html=1;strokeColor=#44546A;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="640" as="sourcePoint"/><mxPoint x="660.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n655c_tower" value="summary from template:&lt;br&gt;&quot;Your SIM was moved to another device at 2:14…&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="414.0" y="655" width="260" height="44" as="geometry"/></mxCell><mxCell id="p17" value="{summary, facts, reason_codes, next_step}" style="edgeStyle=none;html=1;strokeColor=#2E8B57;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="730" as="sourcePoint"/><mxPoint x="140.0" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n745c_alexa" value="speaks summary (or paraphrases)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#9AA7B5;fontSize=9;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="154.0" y="745" width="220" height="30" as="geometry"/></mxCell><mxCell id="p18" value="300 ms timeout → STALE_DATA from Watch.last_state" style="edgeStyle=none;html=1;strokeColor=#C57B7B;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=1;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320.0" y="790" as="sourcePoint"/><mxPoint x="400.0" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rq_n" value="Never on this path: a second model, a phone number toward Alexa+, a location, an unaudited answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#6B7A90;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1520" height="40" as="geometry"/></mxCell><!-- gen_extend:begin --><mxCell id="x_zone" value="Web variant, as designed for prompt 20 (09 §6) — the chat page and the agent stand in for Alexa+ — added by gen_extend.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#2BB3A0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacing=2;fontStyle=1;fontSize=13;fontColor=#1B2B45;dashed=0;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="28" y="940" width="1544" height="400" as="geometry" /></mxCell><mxCell id="x_page" value="&lt;b&gt;Web chat page (browser)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;services/web-chat: index.html + app.js, no build step&lt;br&gt;AWS: S3 + CloudFront; Cognito Hosted UI, code + PKCE → access token&lt;br&gt;local: served by the agent on 127.0.0.1:8083; sign-in stub (Asish | Mom)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="342" height="100" as="geometry" /></mxCell><mxCell id="x_proxy" value="&lt;b&gt;Lambda function URL (AWS only)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;modules/web_chat; CORS = the CloudFront origin&lt;br&gt;forwards Authorization, Content-Type and the Runtime session header,&lt;br&gt;nothing else; no credential, no logging of headers or body&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="432" y="980" width="342" height="100" as="geometry" /></mxCell><mxCell id="x_agent" value="&lt;b&gt;Agent — ref_client/http.py POST /invocations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;no / malformed bearer → 401 before any model or Tower call&lt;br&gt;number in input → 422; Bedrock (Nova Micro) picks the tool&lt;br&gt;AWS: AgentCore Runtime, protocol HTTP, own role (Bedrock + logs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="980" width="342" height="100" as="geometry" /></mxCell><mxCell id="x_tower" value="&lt;b&gt;Tower MCP — steps 2–8 above, unchanged&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;verifies the same bearer (JWKS, issuer, client id) → user_id = sub&lt;br&gt;1 DynamoDB read + the carrier calls; audit before the answer&lt;br&gt;NOT_BOUND → next_step {kind: bind_line, url: BINDING_BASE_URL/bind/&amp;lt;token&amp;gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="1216" y="980" width="342" height="100" as="geometry" /></mxCell><mxCell id="x_e1" value="Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2BB3A0;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_page" target="x_proxy"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="x_e2" value="same" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2BB3A0;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_proxy" target="x_agent"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="x_e3" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2BB3A0;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_agent" target="x_tower"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="x_reply" value="&lt;b&gt;Agent reply {text, next_step, tool_calls}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;next_step = the last non-none tool result's, byte for byte; null if none&lt;br&gt;never from model text; bind_line outside WEB_CHAT_BINDING_BASE_URL/bind/&lt;br&gt;→ null + NEXT_STEP_REJECTED; text passes the digit guard (09 §5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="824" y="1110" width="342" height="100" as="geometry" /></mxCell><mxCell id="x_show" value="&lt;b&gt;Page renders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;text; a bind link only if it starts with BINDING_BASE_URL/bind/&lt;br&gt;“Your line isn't connected yet” + the link (copyable):&lt;br&gt;tap it on your phone (mobile data), then ask again — Path C&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3EF;strokeColor=#2BB3A0;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="342" height="100" as="geometry" /></mxCell><mxCell id="x_e4" value="ToolResult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2BB3A0;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_tower" target="x_reply"><mxGeometry relative="1" as="geometry" x="-0.6678"><Array as="points"><mxPoint x="1387" y="1160" /></Array><mxPoint x="52" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="x_e5" value="200 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2BB3A0;strokeWidth=2;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="x_reply" target="x_show"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="12" as="offset" /></mxGeometry></mxCell><mxCell id="x_exit" value="&lt;b&gt;Refusals, never improvised&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;401 · 422 no_numbers · 502 tower_unavailable · 503 agent_unavailable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C57B7B;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="432" y="1110" width="342" height="44" as="geometry" /></mxCell><mxCell id="x_note" value="&lt;font style=&quot;font-size:10px&quot;&gt;Tower cannot tell this entry from Alexa+ and does not need to: same tools, same identity (sub), same audit rows; nothing is added to the hot path.&lt;br&gt;Never on this lane: a phone number in the input, a prompt or a log; a URL produced by the model; a second policy path; the demo UI's carrier controls.&lt;br&gt;Contracts: e2e-wiring.md §6 (Web chat → agent, Agent → Tower). Deployment: 08-agentcore-deployment page 1 (Cognito, S3/CloudFront, Lambda URL, agent runtime).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#C9D3DF;fontSize=10;fontColor=#8A96A8;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=1;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="60" y="1240" width="1480" height="80" as="geometry" /></mxCell><!-- gen_extend:end --></root></mxGraphModel></diagram></mxfile>