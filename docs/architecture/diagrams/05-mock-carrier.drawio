<mxfile host="app.diagrams.net" agent="Ask the Tower design generator" type="device"><diagram id="05_mock_carrier" name="05 Mock Carrier"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_main" value="08 Mock carrier — internals" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#1B2B45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1440" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="Built to the vendored CAMARA OpenAPI specs. Deterministic clock, scripted timeline, admin API for the demo and the tests." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7A90;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1440" height="22" as="geometry"/></mxCell><mxCell id="m_api" value="CAMARA surface (paths from specs/camara/*.yaml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E0;strokeColor=#E8A33D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="900" height="330" as="geometry"/></mxCell><mxCell id="a_oauth" value="OAuth 2&lt;br&gt;/oauth2/token · /authorize · /bc-authorize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_sim" value="SIM Swap&lt;br&gt;/check · /retrieve-date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_simsub" value="SIM Swap Subscriptions&lt;br&gt;/subscriptions (CloudEvents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_cf" value="Call Forwarding Signal&lt;br&gt;/unconditional-call-forwardings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_nv" value="Number Verification&lt;br&gt;/verify · /device-phone-number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_reach" value="Device Reachability Status&lt;br&gt;/retrieve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_reachsub" value="Reachability Subscriptions&lt;br&gt;/subscriptions (CloudEvents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="500" y="280" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_err" value="Error envelope&lt;br&gt;{status, code, message} per spec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="280" width="200" height="100" as="geometry"/></mxCell><mxCell id="m_core" value="Core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F4;strokeColor=#2BB3A0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;" vertex="1" parent="1"><mxGeometry x="980" y="95" width="480" height="330" as="geometry"/></mxCell><mxCell id="m_state" value="Line state&lt;br&gt;sim_change_at · call_forwarding · reachable&lt;br&gt;connectivity · mobile_data_client_ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="440" height="80" as="geometry"/></mxCell><mxCell id="m_clock" value="Clock&lt;br&gt;set / advance · all timestamps derive from it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1000" y="235" width="210" height="70" as="geometry"/></mxCell><mxCell id="m_tl" value="Timeline&lt;br&gt;scripted events fire as the clock advances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1230" y="235" width="210" height="70" as="geometry"/></mxCell><mxCell id="m_subs" value="Subscription registry + webhook dispatcher&lt;br&gt;CloudEvents to sink · 3 retries · expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=left;spacingLeft=8;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="440" height="70" as="geometry"/></mxCell><mxCell id="m_admin" value="Admin API — /_admin, not CAMARA, disabled unless MOCK_ADMIN=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1B2B45;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1420" height="150" as="geometry"/></mxCell><mxCell id="ad_sc" value="scenarios/load {name}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="260" height="80" as="geometry"/></mxCell><mxCell id="ad_ev" value="lines/{msisdn}/events&lt;br&gt;sim_swap · cf_set · cf_clear · reachable · unreachable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="340" y="505" width="260" height="80" as="geometry"/></mxCell><mxCell id="ad_clock" value="clock {now | advance_s}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="620" y="505" width="260" height="80" as="geometry"/></mxCell><mxCell id="ad_state" value="state (dump)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="900" y="505" width="260" height="80" as="geometry"/></mxCell><mxCell id="ad_fault" value="faults {timeout|500|429, n}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8A9A;fontSize=10;fontColor=#1B2B45;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1180" y="505" width="260" height="80" as="geometry"/></mxCell><mxCell id="m_attr" value="Simulated mobile-data attribution: Number Verification succeeds only for a request carrying an X-Mock-Client-Id listed on the line. Stands in for the carrier seeing the device on its own network." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#6B7A90;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="700" height="80" as="geometry"/></mxCell><mxCell id="m_conf" value="Conformance: the mock serves /openapi.json; CI diffs it against specs/camara/ and runs schemathesis over every operation and error code. The gateway&#x27;s generated tools come from the same files." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#6B7A90;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="700" height="80" as="geometry"/></mxCell><mxCell id="m_det" value="Determinism: no randomness unless MOCK_JITTER_MS is set. scenarios/demo.yaml is checked in; make up loads it, make seed reloads it. The demo is the same every run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontSize=10;fontColor=#6B7A90;align=left;spacingLeft=8;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1420" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_sim" target="m_state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B7583;strokeWidth=1;fontSize=9;fontColor=#3C4858;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_cf" target="m_state"><mxGeometry relati