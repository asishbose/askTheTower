        <mxCell id="ca_p6" value="&lt;b&gt;until 14:00 · repeat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;another UNREACHABLE within 6 h → audited suppressed, not sent&lt;br&gt;once reported, a spell is not re-sent (last_alert_at ≥ unreachable_since)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
