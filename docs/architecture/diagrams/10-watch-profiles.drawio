        <mxCell id="ca_self" value="&lt;b&gt;self profile (&quot;watch my line&quot;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SIM swap + call forwarding only, daily 08:00 + events; no reachability alert;&lt;br&gt;Tower's stored-state path reads this Watch when it is ≤ 10 min old (02 §4).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F8;strokeColor=#6B7583;fontSize=10;fontColor=#1B2B45;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;dashed=0;arcSize=10;absoluteArcSize=1;" vertex="1" parent="1">
