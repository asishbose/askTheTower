# Local compose settings. `make up` copies this file to deploy/compose/.env (gitignored) the first time and
# replaces every `__generate__` with fresh random bytes (base64), so the demo works without edits and no key
# or bearer is ever committed. To change a value, set it in the repo-root .env (the one settings file; see
# /.env.example): `make up` copies it here, replacing the generated one. Editing deploy/compose/.env also works,
# but the root .env wins on the next `make up` for any key it sets.
# Plain KEY=VALUE lines only (no quotes, no inline comments): make, the shell and compose all read this file.
#
# Container-to-container wiring (service hostnames, ports inside the network, TOWER_ENV=local, MOCK_ADMIN=1,
# BIND_ADMIN=1, ALERTS_MODE=local, HOOKS_BASE_URL=https://alerts-tls:8443, TOWER_CLOCK_URL, ALERTS_CLOCK=mock)
# is fixed in docker-compose.yml: it is the shape of the local stack, not a setting.

# --- secrets: local only, generated per machine by `make up` --------------------------------------------
# Tower's local static bearer (X-Tower-User names the user). The host-side `make demo` reads it from .env.
TOWER_BEARER=__generate__
# Bearer Tower presents to Alerts' POST /internal/watch (Alerts: INTERNAL_BEARER, Tower: ALERTS_INTERNAL_BEARER).
INTERNAL_BEARER=__generate__
# line_id HMAC key and msisdn_enc key (base64 of 32 bytes). Shared by tower-mcp, binding-page, alerts, seed.
TOWER_LINE_ID_KEY=__generate__
TOWER_MSISDN_KEY=__generate__
# Binding page: HMAC key for OAuth state, flow/session cookies and CSRF tokens.
SESSION_SECRET=__generate__
# Mock carrier: HS256 key for the access tokens it issues.
MOCK_JWT_SECRET=__generate__
# Mock carrier: bearer for the mutating /_admin routes (G1, 08 §3). Seed, make demo and the demo UI send it.
MOCK_ADMIN_TOKEN=__generate__

# --- the mock carrier's local client registry (services/mock-carrier/config/clients.yaml placeholders) -----
TOWER_CARRIER_CLIENT_SECRET=local-dev-tower
BINDING_CARRIER_CLIENT_SECRET=local-dev-binding
ALERTS_CARRIER_CLIENT_SECRET=local-dev-alerts
MOCK_CIBA=0
MOCK_JITTER_MS=0

# --- behaviour ---------------------------------------------------------------------------------------------
TOWER_TZ=America/Toronto
CARRIER_SUPPORT_NUMBER=611
# Public URL of the binding page: links in Tower's next_step and the QR code. For a phone on the same Wi-Fi:
# http://<laptop LAN address>:8081 (WSL2: mirrored networking or a port proxy).
BINDING_PUBLIC_URL=http://localhost:8081
SESSION_TTL_S=1800
# Alerts: "SMS" is a log line (make logs | grep SMS). log | webhook (log + POST to SMS_GATEWAY_URL).
ALERTS_SENDER=log
# Optional, rehearsal only: an SMS-gateway app on a phone that accepts POST {"to","body"} (see README "Phone buzz").
SMS_GATEWAY_URL=
# The local scheduler's cadences are divided by this (60: the 5-minute poll runs every 5 s). Time itself
# comes from the mock's clock.
ALERTS_CLOCK_SCALE=60
LOG_LEVEL=info
# Alexa+ simulator through a tunnel (docs/architecture/alexa/registration.md). Empty = static bearer only.
# The identity provider's JWKS / issuer, and the account-linking app client id (Cognito: client_id, no aud).
TOWER_JWKS_URL=
TOWER_JWT_ISSUER=
TOWER_JWT_AUDIENCE=
TOWER_JWT_CLIENT_IDS=
# 1: Tower logs each tool call + result (local only); make showcase-alexa turns them into transcripts.
# The five TOWER_JWT*/TOWER_JWKS_URL/TOWER_CALL_LOG keys are read only by docker-compose.alexa.yml.
TOWER_CALL_LOG=1
AWS_REGION=us-east-1
TOWER_TABLE_PREFIX=
# ref-client: auto = Bedrock when AWS credentials are configured, else the scripted agent. bedrock | scripted.
REF_AGENT=auto
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# --- host ports (match mk/vars.mk: TOWER_URL, MOCK_URL, BINDING_URL, ALERTS_URL, DYNAMO_ENDPOINT) ------------
DYNAMO_HOST_PORT=8000
MOCK_HOST_PORT=8443
TOWER_HOST_PORT=8080
BINDING_HOST_PORT=8081
ALERTS_HOST_PORT=8082
DEMO_UI_HOST_PORT=8090
# The web chat page + agent (09 §6; the ref-client image's HTTP app), published on 127.0.0.1 only.
WEB_CHAT_HOST_PORT=8083
IMAGE_TAG=latest
