# binding-page — copy to .env (gitignored). Placeholders only; never commit real values.
# Every variable is described in README.md (and in src/binding_page/config.py).

# local = mobile-data simulation (?as=phone-asish) on; anything else (aws, eks) = simulation inert.
TOWER_ENV=local
# Public base URL of this page (links, QR code). On a LAN demo: http://<laptop LAN address>:8081
BASE_URL=http://localhost:8081
# OAuth redirect URI registered with the carrier (default <BASE_URL>/bind/callback).
BIND_REDIRECT_URI=http://localhost:8081/bind/callback
# HMAC key for the OAuth state, flow/session cookies and CSRF tokens; >= 16 chars (e.g. `openssl rand -base64 32`).
SESSION_SECRET=
SESSION_TTL_S=1800
# 1 serves /_admin/* (the showcase's tables view) — only when TOWER_ENV=local.
BIND_ADMIN=0
# Alerts' internal endpoint: a watch-settings save on an enabled Watch re-subscribes the line (04 §9.2).
# Unset → log-only stub (the Alerts polls still find the Watch). The bearer is Alerts' INTERNAL_BEARER.
ALERTS_INTERNAL_URL=
ALERTS_INTERNAL_BEARER=
PORT=8081
LOG_LEVEL=info

# Consent / audit store (DynamoDB Local in compose; unset on AWS)
DYNAMO_ENDPOINT=http://dynamodb-local:8000
TOWER_TABLE_PREFIX=
AWS_REGION=us-east-1
# Local keys: base64 of >= 32 random bytes each (`openssl rand -base64 32`). On AWS: TOWER_KMS_HMAC_KEY_ID / TOWER_KMS_KEY_ID.
TOWER_LINE_ID_KEY=
TOWER_MSISDN_KEY=
TOWER_KMS_HMAC_KEY_ID=
TOWER_KMS_KEY_ID=

# Carrier (camara_client.CarrierConfig.from_env). direct = DirectClient (local); gateway = AgentCore Gateway (AWS).
CARRIER_CLIENT=direct
CARRIER_BACKEND=mock
CARRIER_BASE_URL=http://mock-carrier:8443
CARRIER_AUTHORIZE_URL=
CARRIER_TOKEN_URL=
CARRIER_CLIENT_ID=binding-page
CARRIER_SCOPES=number-verification
CARRIER_PROFILE=proactive
CARRIER_SECRET_REF=env:CARRIER_CLIENT_SECRET
# The mock's local placeholder is in services/mock-carrier/config/clients.yaml; a real secret never goes here.
CARRIER_CLIENT_SECRET=
CARRIER_GATEWAY_URL=
CARRIER_GATEWAY_TOOLS=
