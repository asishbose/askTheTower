# tower-mcp — copy to .env (gitignored). Placeholders only; never commit real values.
# Identity (RUN-ALL Decisions): Bearer JWT, user_id = `sub`; local mode also accepts TOWER_BEARER + X-Tower-User.
TOWER_ENV=local
TOWER_BEARER=change-me-local-bearer
TOWER_JWKS_URL=
TOWER_JWT_ISSUER=
# Lists are comma-separated. Access tokens from Amazon Cognito carry client_id and no aud: set TOWER_JWT_CLIENT_IDS.
TOWER_JWT_AUDIENCE=
TOWER_JWT_CLIENT_IDS=
TOWER_PORT=8000
TOWER_TZ=America/Toronto
# Local demo only: follow the mock carrier's clock so "twelve minutes ago" on the mock is now for the policy.
TOWER_CLOCK_URL=http://mock-carrier:8443/_admin/clock
LOG_LEVEL=info
# Local demo only: 1 logs each tool call + result as a `tower_mcp.calls` line (make showcase-alexa → transcripts).
TOWER_CALL_LOG=0

# Consent / audit store (DynamoDB Local in compose; unset on AWS)
DYNAMO_ENDPOINT=http://dynamodb-local:8000
TOWER_TABLE_PREFIX=
AWS_REGION=us-east-1
# Local keys: base64 of >= 32 random bytes each (e.g. `openssl rand -base64 32`). On AWS use TOWER_KMS_HMAC_KEY_ID / TOWER_KMS_KEY_ID.
TOWER_LINE_ID_KEY=
TOWER_MSISDN_KEY=

# Carrier (camara_client.CarrierConfig.from_env)
CARRIER_CLIENT=direct
CARRIER_BACKEND=mock
CARRIER_BASE_URL=http://mock-carrier:8443
CARRIER_CLIENT_ID=tower
CARRIER_SECRET_REF=env:CARRIER_CLIENT_SECRET
CARRIER_CLIENT_SECRET=local-dev-tower
CARRIER_GATEWAY_URL=
CARRIER_GATEWAY_TOOLS=

# next_step
BINDING_BASE_URL=http://localhost:8081
# The carrier's public support line (a short code or published number) — config, not anyone's line.
CARRIER_SUPPORT_NUMBER=611

# Alerts internal API (prompt 10). Unset → a log-only stub records watch_line's (un)subscribe calls.
ALERTS_INTERNAL_URL=http://alerts:8082
ALERTS_INTERNAL_BEARER=change-me-internal-bearer
