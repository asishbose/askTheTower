# alerts — copy to .env (gitignored). Placeholders only; never commit real values.
ALERTS_MODE=local                      # lambda | local | k8s
HOOKS_BASE_URL=https://alerts.example  # public https base for /hooks/{kind}/{token} (CAMARA sinks must be https)
INTERNAL_BEARER=change-me              # bearer Tower uses for POST /internal/watch; unset = internal API refuses
ALERTS_SENDER=log                      # sns | log | webhook   (default: sns in lambda mode, log locally)
SNS_TOPIC_ARN=                         # AWS: the two-way-SMS inbound topic (ack replies) — set by Terraform
SMS_GATEWAY_URL=                       # local, optional: POST {"to","body"} per SMS (an SMS-gateway app on a phone)
ALERTS_CLOCK=mock                      # mock (follow the mock carrier's clock) | system
ALERTS_CLOCK_SCALE=60                  # local scheduler cadences ÷ this (60: the 5-min poll runs every 5 s)
ALERTS_TRANSPLANT_POLL_S=300
ALERTS_CARE_POLL_S=1800
ALERTS_DAILY_POLL_S=86400
ALERTS_TICK_S=60
ALERTS_DEFAULT_TZ=America/Toronto
ALERTS_SUBSCRIPTION_TTL_H=720
ALERTS_PORT=8082
# carrier (camara_client.CarrierConfig.from_env) — Alerts defaults: proactive profile, client id "alerts"
CARRIER_CLIENT=direct
CARRIER_BASE_URL=http://mock-carrier:8443
CARRIER_CLIENT_ID=alerts
CARRIER_SECRET_REF=env:CARRIER_CLIENT_SECRET
CARRIER_CLIENT_SECRET=placeholder
CARRIER_PROFILE=proactive
# store and crypto (tower_consent)
DYNAMO_ENDPOINT=http://dynamodb-local:8000   # alias of TOWER_DYNAMODB_ENDPOINT; unset on AWS
TOWER_TABLE_PREFIX=
AWS_REGION=us-east-1
TOWER_ENV=local
TOWER_LINE_ID_KEY=base64-32-bytes-placeholder
TOWER_MSISDN_KEY=base64-32-bytes-placeholder
LOG_LEVEL=info
