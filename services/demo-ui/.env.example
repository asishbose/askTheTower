# demo-ui (docs/architecture/components/11-demo-ui.md). Placeholders only; `make showcase-ui` fills these from
# mk/vars.mk and deploy/compose/.env, and compose sets them in docker-compose.yml. Never commit real values.
ENV=local
TOWER_URL=http://localhost:8080/mcp
TOWER_BEARER=<from deploy/compose/.env>
MOCK_URL=http://localhost:8443
MOCK_ADMIN_TOKEN=<from deploy/compose/.env>
BINDING_URL=http://localhost:8081
ALERTS_URL=http://localhost:8082
ALERTS_INTERNAL_BEARER=<INTERNAL_BEARER from deploy/compose/.env>
# mapped to TOWER_DYNAMODB_ENDPOINT (the only name Store.from_env reads); empty on ENV=aws (real DynamoDB)
DYNAMO_ENDPOINT=http://localhost:8000
TOWER_TABLE_PREFIX=
AWS_REGION=us-east-1
# auto = Bedrock when AWS credentials resolve, else scripted | bedrock | scripted
REF_AGENT=auto
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
DEMO_UI_HOST=127.0.0.1
DEMO_UI_PORT=8090
# 1 only where the container listens on 0.0.0.0 but is published on loopback (compose, kind port-forward)
DEMO_UI_PUBLISHED_LOOPBACK=0
# required for any non-loopback DEMO_UI_HOST: open the page once with ?token=<value>
DEMO_UI_TOKEN=
FEED_POLL_S=2
# the `make seed` module Reset runs; found from the checkout when empty
DEMO_UI_SEED_PATH=
