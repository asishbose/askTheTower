# ref-client — copy to .env (gitignored). Placeholders only; never commit real values.
# Tower (Streamable HTTP). Local: the static bearer + X-Tower-User (set by --user). AWS: the bearer is the JWT.
TOWER_URL=http://localhost:8080/mcp
TOWER_BEARER=change-me-local-bearer
# Demo controls (local only): the mock's /_admin and the binding page's local grant admin (BIND_ADMIN=1).
MOCK_URL=http://localhost:8443
BINDING_URL=http://localhost:8081
# Bedrock — the only model call in the repository. Default: Nova Micro.
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_REGION=us-east-1
# auto = Bedrock when AWS credentials are configured, else the scripted agent (demo only). bedrock | scripted.
REF_AGENT=auto
# 1 = speak answers through Amazon Polly (and `ref-client say -` listens on the mic). Off by default.
REF_VOICE=0
# Corpus gate: fraction of phrasings that must select the expected tool.
CORPUS_MIN_PASS=0.9

# --- As the web chat page's agent (`ref-client serve`, the image's default command; 09 §6) ---------------------
# Container port: AgentCore Runtime requires 8080; compose publishes it on 127.0.0.1:8083.
REF_CLIENT_HTTP_PORT=8080
# local: X-Tower-User is forwarded and GET /config.js serves the sign-in stub (with TOWER_BEARER). aws: neither.
TOWER_ENV=local
# The binding page base: a bind_line next_step outside <this>/bind/ is dropped (NEXT_STEP_REJECTED).
WEB_CHAT_BINDING_BASE_URL=http://localhost:8081
# Serve services/web-chat at / (local). Empty on AWS (the page is on S3 + CloudFront).
WEB_CHAT_DIR=../web-chat
# The page's own config (config.js, not env: COGNITO_DOMAIN, CLIENT_ID, REDIRECT_URI, AGENT_URL, BINDING_BASE_URL)
# is rendered by `make web-chat-sync` on AWS and by GET /config.js locally — see services/web-chat/config.js.example.
