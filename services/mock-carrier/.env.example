# mock-carrier — copy to .env (gitignored). Placeholders only; never commit real values.
# Simulation aids: /_admin/* exists only with MOCK_ADMIN=1; X-Mock-Client-Id stands in for the
# cellular network's device attribution. Neither exists on a real carrier.
MOCK_ADMIN=1
MOCK_CIBA=0
MOCK_JITTER_MS=0
MOCK_PORT=8443
MOCK_TLS_CERT=
MOCK_TLS_KEY=
MOCK_SCENARIO=demo
MOCK_BASE_URL=http://localhost:8443
MOCK_JWT_SECRET=change-me-local-only
# Optional overrides (defaults shown are the image's)
# MOCK_SPECS_DIR=/app/specs/camara
# MOCK_SCENARIOS_DIR=/app/scenarios
# MOCK_CLIENTS_FILE=/app/config/clients.yaml
# MOCK_TOKEN_TTL_S=86400
# MOCK_FAULT_TIMEOUT_S=0.5
# MOCK_WEBHOOK_BACKOFF_S=0.2
# MOCK_WEBHOOK_TIMEOUT_S=2.0
# MOCK_LOOPBACK_SINK_HOST=sink.mock.local
# AWS only (08 §3): assume every authorize request comes from this client id on mobile data.
# Compose, kind and the tests keep it off. Refused together with X-Mock-Client-Id.
MOCK_ASSUME_MOBILE_DATA=0
MOCK_ASSUME_CLIENT_ID=phone-asish
